<button
  class="weui-btn app-button app-button--{{variant}} app-button--{{size}} {{block ? 'app-button--block' : ''}} {{extClass}}"
  loading="{{false}}"
  disabled="{{disabled || loading}}"
  open-type="{{openType}}"
  form-type="{{formType}}"
  hover-class="{{disabled ? '' : hoverClass}}"
  lang="{{lang}}"
  session-from="{{sessionFrom}}"
  send-message-title="{{sendMessageTitle}}"
  send-message-path="{{sendMessagePath}}"
  send-message-img="{{sendMessageImg}}"
  show-message-card="{{showMessageCard}}"
  app-parameter="{{appParameter}}"
  bindtap="handleTap"
  bindgetuserinfo="forwardEvent"
  bindcontact="forwardEvent"
  bindgetphonenumber="forwardEvent"
  binderror="forwardEvent"
  bindopensetting="forwardEvent"
  bindlaunchapp="forwardEvent"
  bindchooseavatar="forwardEvent"
>
  <view class="app-button__inner">
    <app-icon
      wx:if="{{loading}}"
      className="app-button__loading-icon app-button__loading-icon--spin"
      name="status-loading-primary"
      color="{{variant === 'primary' ? '#ffffff' : '#18bcc5'}}"
    />
    <slot>{{text}}</slot>
  </view>
</button>
