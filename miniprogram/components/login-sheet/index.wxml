<app-sheet visible="{{visible}}" extClass="login-sheet-panel" bind:close="handleClose">
  <view slot="desc" class="login-sheet">
    <view class="login-sheet-icon">
      <app-icon className="login-sheet-bolt" name="highlight-bolt-primary" />
    </view>
    <view class="login-sheet-title">天天体育宝欢迎你</view>
    <view class="login-sheet-subtitle">为了提供更好的服务，我们需要获取你的授权</view>
    <view class="login-sheet-button-row">
      <app-button extClass="login-sheet-secondary-button" variant="secondary" disabled="{{loading}}" bind:tap="handleClose">
        稍后登录
      </app-button>
      <app-button extClass="login-sheet-button" variant="primary" loading="{{loading}}" bind:tap="handleConfirm">
        微信一键登录
      </app-button>
    </view>
    <app-checkbox
      value="agree"
      checked="{{agreementChecked}}"
      color="#18bcc5"
      extClass="login-sheet-checkbox"
      bind:change="handleAgreementChange"
    >
      <view class="login-sheet-agreement">
        <text>我已阅读并同意</text>
        <text class="login-sheet-link" bindtap="handleOpenAgreement">用户协议</text>
        <text>和</text>
        <text class="login-sheet-link" bindtap="handleOpenPrivacy">隐私政策</text>
      </view>
    </app-checkbox>
  </view>
</app-sheet>
