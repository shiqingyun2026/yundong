.login-sheet {
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  background: #ffffff;
}

.login-sheet-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  margin: 24rpx auto 0;
  border-radius: 50%;
  background: var(--brand-primary-soft-strong);
}

.login-sheet-bolt {
  width: 56rpx;
  height: 56rpx;
}

.login-sheet-title {
  margin-top: 28rpx;
  font-size: 42rpx;
  font-weight: 600;
  text-align: center;
  color: #1f2329;
  line-height: 1.4;
}

.login-sheet-subtitle {
  margin-top: 16rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  line-height: 1.7;
  text-align: center;
  color: #6b7280;
}

.login-sheet-button-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 36rpx;
}

.login-sheet-button,
.login-sheet-secondary-button {
  flex: 1;
  height: 96rpx;
  font-size: 30rpx;
  line-height: 1;
}

.login-sheet-button {
  background: linear-gradient(90deg, var(--brand-primary) 0%, var(--brand-primary-light) 100%);
  box-shadow: 0 8rpx 20rpx var(--brand-primary-shadow-strong);
  color: #ffffff;
  font-weight: 500;
}

.login-sheet-secondary-button {
  border: 2rpx solid #dbe3f0;
  background: #ffffff;
  color: #6b7280;
  font-weight: 500;
}

.login-sheet-checkbox {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 0 28rpx;
}

.login-sheet-checkbox .app-checkbox__control {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 48rpx;
  min-height: 48rpx;
  margin-top: 4rpx;
}

.login-sheet-checkbox .app-checkbox__indicator {
  width: 40rpx;
  height: 40rpx;
  font-size: 34rpx;
}

.login-sheet-agreement {
  max-width: 480rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #6b7280;
  text-align: center;
}

.login-sheet-link {
  color: var(--brand-primary);
  font-weight: 500;
}
