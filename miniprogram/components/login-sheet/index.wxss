.login-sheet-root {
  position: fixed;
  inset: 0;
  z-index: 2000;
}

.login-sheet-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.login-sheet-mask--show {
  opacity: 1;
}

.login-sheet-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 36rpx 48rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 44rpx 44rpx 0 0;
  background: linear-gradient(180deg, #ffffff 0%, #fefefe 100%);
  box-shadow: 0 -24rpx 72rpx rgba(15, 23, 42, 0.14);
  transform: translate3d(0, 100%, 0);
  transition: transform 0.3s ease;
}

.login-sheet-panel--show {
  transform: translate3d(0, 0, 0);
}

.login-sheet-panel--hide {
  transform: translate3d(0, 100%, 0);
}

.login-sheet-close {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  height: 52rpx;
}

.login-sheet-close-icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
}

.login-sheet-close-icon::before,
.login-sheet-close-icon::after {
  content: '';
  position: absolute;
  left: 14rpx;
  top: 1rpx;
  width: 4rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: #a9b0bc;
}

.login-sheet-close-icon::before {
  transform: rotate(45deg);
}

.login-sheet-close-icon::after {
  transform: rotate(-45deg);
}

.login-sheet-brand {
  margin-top: 16rpx;
  display: flex;
  justify-content: center;
}

.login-sheet-brand-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 184rpx;
  height: 184rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 38%, rgba(255, 255, 255, 0.96), #f9fdfe 78%, #ecf9fa 100%);
  box-shadow:
    0 8rpx 20rpx rgba(26, 188, 197, 0.12),
    inset 0 0 0 2rpx rgba(26, 188, 197, 0.08);
}

.login-sheet-brand-ring {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #0bb4bb;
  background: #ffffff;
  box-shadow: 0 6rpx 14rpx rgba(26, 188, 197, 0.08);
}

.login-sheet-brand-mark {
  position: relative;
  width: 68rpx;
  height: 52rpx;
}

.login-sheet-brand-mark-dot {
  position: absolute;
  right: 4rpx;
  top: 0;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #08aeb5;
}

.login-sheet-brand-mark-line {
  position: absolute;
  left: 0;
  height: 4rpx;
  border-radius: 999rpx;
  background: #08aeb5;
}

.login-sheet-brand-mark-line--top {
  top: 10rpx;
  width: 30rpx;
}

.login-sheet-brand-mark-line--middle {
  top: 22rpx;
  width: 40rpx;
}

.login-sheet-brand-mark-line--bottom {
  top: 34rpx;
  width: 24rpx;
}

.login-sheet-brand-mark::before {
  content: '';
  position: absolute;
  left: 26rpx;
  top: 15rpx;
  width: 18rpx;
  height: 28rpx;
  border-right: 6rpx solid #08aeb5;
  border-bottom: 6rpx solid #08aeb5;
  transform: skew(-18deg) rotate(38deg);
}

.login-sheet-brand-mark::after {
  content: '';
  position: absolute;
  left: 36rpx;
  top: 26rpx;
  width: 24rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #08aeb5;
  transform: rotate(-28deg);
}

.login-sheet-brand-name {
  margin-top: 8rpx;
  font-size: 18rpx;
  line-height: 1.2;
  color: #089ea5;
  font-weight: 700;
}

.login-sheet-header {
  text-align: center;
  margin-top: 52rpx;
}

.login-sheet-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #101828;
  line-height: 1.24;
  letter-spacing: 1rpx;
}

.login-sheet-checkbox {
  position: relative;
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  border: 2rpx solid #d0d5dd;
  background: #ffffff;
  transition: all 0.2s ease;
}

.login-sheet-checkbox--checked {
  border-color: #26c2c9;
  background: #26c2c9;
  box-shadow: 0 8rpx 18rpx rgba(38, 194, 201, 0.16);
}

.login-sheet-checkbox-tick {
  position: absolute;
  left: 12rpx;
  top: 7rpx;
  width: 10rpx;
  height: 18rpx;
  border-right: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(40deg);
}

.login-sheet-action-group {
  margin-top: 68rpx;
  width: 100%;
}

.login-sheet-primary.weui-ext-button.weui-btn {
  width: 100%;
  height: 106rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #31c8d0 0%, #27bdc6 100%);
  box-shadow: 0 18rpx 36rpx rgba(38, 194, 201, 0.28);
  font-size: 48rpx;
  font-weight: 700;
}

.login-sheet-primary.weui-ext-button[disabled] {
  opacity: 0.72;
}

.login-sheet-primary .weui-ext-button__inner {
  width: 100%;
}

.login-sheet-agreement-row {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 16rpx;
  margin-top: 42rpx;
  padding: 0 12rpx;
}

.login-sheet-agreement-copy {
  flex: 0 1 auto;
  font-size: 24rpx;
  line-height: 1.6;
  color: #98a2b3;
  white-space: nowrap;
}

.login-sheet-agreement-link {
  color: #26c2c9;
  font-weight: 500;
}

.login-sheet-home-indicator {
  width: 168rpx;
  height: 8rpx;
  margin: 54rpx auto 0;
  border-radius: 999rpx;
  background: rgba(16, 24, 40, 0.82);
}
