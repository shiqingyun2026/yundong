.weui-navigation-bar {
  position: relative;
  width: 100%;
  overflow: hidden;
  color: #1f2329;
}

.weui-navigation-bar__placeholder {
  width: 100%;
  flex-shrink: 0;
}

.weui-navigation-bar__inner {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 5001;
  display: flex;
  align-items: center;
  box-sizing: content-box;
}

.weui-navigation-bar__left,
.weui-navigation-bar__center,
.weui-navigation-bar__right {
  display: flex;
  align-items: center;
}

.weui-navigation-bar__left {
  position: relative;
  min-width: 0;
  padding-left: 16px;
  flex-shrink: 0;
}

.weui-navigation-bar__center {
  position: relative;
  flex: 1;
  justify-content: center;
  min-width: 0;
  text-align: center;
  font-size: 17px;
}

.weui-navigation-bar__right {
  flex-shrink: 0;
  justify-content: flex-end;
  margin-right: 16px;
}

.weui-navigation-bar__loading {
  display: inline-flex;
  align-items: center;
  margin-right: 4px;
}

.weui-navigation-bar__btn_goback_wrapper {
  padding: 11px 18px 11px 16px;
  margin: -11px -18px -11px -16px;
}

.weui-navigation-bar__loading-icon {
  width: 24rpx;
  height: 24rpx;
}

.weui-navigation-bar__loading-icon--spin {
  animation: weui-nav-loading-spin 0.9s linear infinite;
}

@keyframes weui-nav-loading-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}
