<view class="agreement-content-page">
  <view class="agreement-content-header">
    <view class="agreement-content-title">{{title}}</view>
    <view class="agreement-content-subtitle">{{subtitle}}</view>
  </view>

  <view class="weui-panel weui-ext-card agreement-content-card card-shadow">
    <scroll-view class="agreement-content-body" scroll-y>
      <rich-text class="agreement-content-rich-text" nodes="{{contentNodes}}"></rich-text>
    </scroll-view>
  </view>
</view>
