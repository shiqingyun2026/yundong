<view class="agreement-list-page">
  <app-cells extClass="agreement-list-cells agreement-list-card">
    <app-cell
      wx:for="{{agreementList}}"
      wx:key="key"
      wx:for-index="index"
      extClass="agreement-list-cell {{index > 0 ? 'agreement-list-cell--with-divider' : ''}}"
      hasHeader="{{false}}"
      hasFooter="{{true}}"
      data-key="{{item.key}}"
      bind:tap="handleOpenAgreement"
    >
      <view class="agreement-list-main">
        <view class="agreement-list-item-title">{{item.title}}</view>
      </view>
      <app-icon slot="footer" className="agreement-list-arrow" name="nav-forward-muted" />
    </app-cell>
  </app-cells>
</view>
