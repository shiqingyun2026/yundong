<view class="agreement-page">
  <mp-toptips id="ui-toptips" root-portal="{{true}}" />
  <view class="agreement-header">
    <view class="agreement-title">欢迎使用天天体育宝</view>
    <view class="agreement-subtitle">为保障你的账户与隐私权益，请先阅读并同意《用户协议》和《隐私政策》后再继续使用。</view>
  </view>

  <view class="agreement-tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="agreement-tab {{activeTab === item.key ? 'agreement-tab--active' : ''}}"
      data-tab="{{item.key}}"
      bindtap="handleTabChange"
    >
      {{item.label}}
    </view>
  </view>

  <scroll-view class="agreement-content" scroll-y>
    <rich-text
      wx:if="{{activeTab === 'user'}}"
      class="agreement-rich-text"
      nodes="{{userAgreementNodes}}"
    ></rich-text>
    <rich-text
      wx:else
      class="agreement-rich-text"
      nodes="{{privacyPolicyNodes}}"
    ></rich-text>
  </scroll-view>

  <view wx:if="{{!readonly}}" class="agreement-footer">
    <mp-cells extClass="agreement-consent-cells">
      <mp-checkbox-group bind:change="handleAgreementChange">
        <mp-checkbox
          extClass="agreement-consent-item"
          value="agreed"
          checked="{{agreed}}"
          label="我已阅读并同意《用户协议》和《隐私政策》"
        />
      </mp-checkbox-group>
    </mp-cells>
    <view class="agreement-checkbox-tip">继续进入即表示你接受平台服务规则与隐私说明。</view>

    <view class="agreement-actions">
      <button class="weui-btn weui-ext-button weui-ext-button--large weui-ext-button--secondary footer-button reject-button" bindtap="handleRejectTap">
        <view class="weui-ext-button__inner">拒绝</view>
      </button>
      <button class="weui-btn weui-ext-button weui-ext-button--large weui-ext-button--primary footer-button agree-button" bindtap="handleAgree">
        <view class="weui-ext-button__inner">同意并进入</view>
      </button>
    </view>
  </view>

  <mp-dialog
    show="{{showRejectModal}}"
    title="提示"
    root-portal="{{true}}"
    buttons="{{rejectDialogButtons}}"
    bind:close="handleCloseRejectModal"
    bind:buttontap="handleRejectDialogTap"
  >
    <view class="section-desc">您需要同意协议才能使用本小程序</view>
  </mp-dialog>
</view>
