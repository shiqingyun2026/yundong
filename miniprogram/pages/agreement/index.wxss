.agreement-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  padding: 36rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at top left, rgba(26, 188, 197, 0.12), transparent 36%),
    linear-gradient(180deg, #f5f9ff 0%, #f7f8fa 38%, #f3f5f8 100%);
}

.agreement-header {
  padding: 12rpx 8rpx 28rpx;
}

.agreement-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2329;
  letter-spacing: 1rpx;
}

.agreement-subtitle {
  max-width: 640rpx;
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #5f6b7a;
}

.agreement-tabs {
  display: flex;
  gap: 10rpx;
  padding: 10rpx;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  background: rgba(26, 188, 197, 0.08);
}

.agreement-tab {
  flex: 1;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: transparent;
  color: #6a7787;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.agreement-tab--active {
  background-color: var(--brand-primary);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(26, 188, 197, 0.2);
}

.agreement-content {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 32rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(207, 217, 230, 0.9);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 16rpx 40rpx rgba(31, 35, 41, 0.08);
  overflow: hidden;
}

.agreement-rich-text {
  color: #1f2329;
  font-size: 28rpx;
  line-height: 1.8;
}

.rich-block {
  margin-bottom: 32rpx;
}

.rich-title {
  margin-bottom: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
}

.rich-paragraph {
  margin-bottom: 16rpx;
  color: #3c4655;
}

.rich-list {
  padding-left: 32rpx;
}

.rich-list-item {
  margin-bottom: 16rpx;
  color: #3c4655;
}

.agreement-footer {
  position: sticky;
  bottom: 0;
  z-index: 5;
  flex-shrink: 0;
  padding-top: 24rpx;
  padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
  margin: 0 -24rpx calc(-24rpx - env(safe-area-inset-bottom));
  padding-left: 24rpx;
  padding-right: 24rpx;
  background: linear-gradient(180deg, rgba(243, 245, 248, 0) 0%, rgba(243, 245, 248, 0.92) 20%, #f3f5f8 48%);
}

.agreement-consent-cells.weui-cells__group {
  margin-top: 0;
}

.agreement-consent-cells .weui-cells {
  margin-top: 0;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 28rpx rgba(31, 35, 41, 0.06);
}

.agreement-consent-cells .weui-cells::before,
.agreement-consent-cells .weui-cells::after {
  display: none;
}

.agreement-consent-item.weui-cell {
  padding: 24rpx;
  background: transparent;
}

.agreement-consent-item.weui-cell::before {
  display: none;
}

.agreement-consent-item .weui-cell__bd {
  font-size: 26rpx;
  line-height: 1.6;
  color: #1f2329;
  font-weight: 600;
}

.agreement-checkbox-tip {
  padding: 8rpx 24rpx 0;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #7b8694;
}

.agreement-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.footer-button {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 999rpx;
  border: none;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(31, 35, 41, 0.08);
}

.footer-button::after {
  border: none;
}

.reject-button {
  background: #eef2f6;
  color: #5f6b7a;
}

.agree-button {
  background: var(--brand-primary);
  color: #ffffff;
}
