<view class="detail-page">
  <mp-toptips id="ui-toptips" />
  <view wx:if="{{loading}}" class="page-loading">
    <mp-loading show="{{loading}}" type="dot-gray" />
    <text class="page-loading-text">详情加载中...</text>
  </view>

  <scroll-view wx:if="{{!loading && courseDetail}}" class="detail-scroll" scroll-y>
    <swiper class="hero-swiper" indicator-dots autoplay circular>
      <swiper-item wx:for="{{courseDetail.images}}" wx:key="*this">
        <image class="hero-image" src="{{item}}" mode="aspectFill"></image>
      </swiper-item>
    </swiper>

    <view class="detail-content">
      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="title-row">
          <view class="course-title">{{courseDetail.title}}</view>
          <mp-badge wx:if="{{hasActiveGroup}}" extClass="weui-ext-tag group-chip" content="{{groupTargetCount}}人成团" />
        </view>

        <view class="price-row">
          <view class="group-price">¥{{courseDetail.groupPriceText}}</view>
          <view class="original-price">¥{{courseDetail.originalPriceText}}</view>
          <mp-badge wx:if="{{showJoinedCount}}" extClass="weui-ext-tag joined-chip" content="已拼 {{displayJoinedCount}} 人" />
        </view>

        <view class="info-list">
          <view class="info-item">
            <view class="info-label">上课时间</view>
            <view class="info-value">{{courseDetail.timeText}}</view>
          </view>
          <view class="info-item">
            <view class="info-label">上课地点</view>
            <view class="info-value">{{courseDetail.locationText}}</view>
          </view>
          <view class="info-item">
            <view class="info-label">适用年龄</view>
            <view class="info-value">{{courseDetail.ageRange}}</view>
          </view>
        </view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">课程介绍</view>
        <rich-text class="rich-text" nodes="{{courseDetail.descriptionHtml || courseDetail.descriptionNodes}}"></rich-text>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">拼团规则</view>
        <rich-text class="rich-text" nodes="{{courseDetail.groupRuleNodes}}"></rich-text>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">教练信息</view>
        <view class="coach-name">{{courseDetail.coach.name}}</view>
        <view class="coach-intro">{{courseDetail.coach.intro}}</view>
        <view class="certificate-list">
          <image
            wx:for="{{courseDetail.coach.certificates}}"
            wx:key="*this"
            class="certificate-image"
            src="{{item}}"
            mode="aspectFill"
            data-url="{{item}}"
            bindtap="handlePreviewCertificate"
          ></image>
        </view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow insurance-card">
        <view class="section-title">保险说明</view>
        <view class="section-desc insurance-text">{{courseDetail.insuranceText}}</view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">当前拼团状态</view>
        <view wx:if="{{courseGroupList.length}}" class="group-panel">
          <view wx:for="{{courseGroupList}}" wx:key="groupId" class="weui-panel weui-ext-card group-item-card">
            <view class="group-item-header">
              <view class="group-item-title">第{{item.index}}个团</view>
              <mp-badge extClass="weui-ext-tag group-item-status group-item-status-{{item.statusClass}}" content="{{item.statusText}}" />
            </view>

            <view class="group-progress-row">
              <view class="group-progress-text">当前进度 {{item.progressText}}</view>
              <view class="group-progress-caption">{{item.caption}}</view>
            </view>
            <view class="progress-track">
              <view class="progress-bar" style="width: {{item.progressPercent}};"></view>
            </view>
          </view>
        </view>

        <view wx:else class="group-empty">
          <view class="section-desc">{{emptyGroupText}}</view>
        </view>
      </view>

      <view class="bottom-space"></view>
    </view>
  </scroll-view>

  <view wx:if="{{!loading && courseDetail}}" class="bottom-bar">
    <view class="service-entry" bindtap="handleOpenService">
      <view class="service-icon">
        <mp-icon extClass="service-icon-image" icon="contacts" type="filled" color="#18bcc5" size="{{28}}" />
      </view>
      <view class="service-text">客服</view>
    </view>
    <button
      class="weui-btn weui-ext-button weui-ext-button--large weui-ext-button--primary bottom-action"
      bindtap="handleGoPayment"
      loading="{{creatingOrder}}"
      disabled="{{creatingOrder || actionButtonDisabled}}"
    >
      <view class="weui-ext-button__inner">{{actionButtonText}}</view>
    </button>
  </view>

  <mp-dialog
    wx:if="{{courseDetail}}"
    show="{{showServiceModal}}"
    title="联系客服"
    buttons="{{serviceDialogButtons}}"
    bind:close="handleCloseService"
    bind:buttontap="handleServiceDialogTap"
  >
    <view class="service-modal-content">
      <image class="service-qrcode" src="{{courseDetail.serviceQrCode}}" mode="aspectFit"></image>
      <view class="service-tip">请使用微信扫码联系专属客服</view>
    </view>
  </mp-dialog>

  <mp-half-screen-dialog show="{{showLoginModal}}" closabled="{{true}}" mask="{{true}}" ext-class="login-sheet-panel" bind:close="handleCloseLoginModal">
    <view slot="desc" class="login-sheet">
      <view class="login-sheet-icon">
        <mp-icon extClass="login-sheet-bolt" icon="discover" type="filled" color="#12aab3" size="{{56}}" />
      </view>
      <view class="login-sheet-title">天天体育宝欢迎你</view>
      <view class="login-sheet-subtitle">为了提供更好的服务，我们需要获取你的授权</view>
      <view class="login-sheet-button-row">
        <button class="weui-btn weui-ext-button weui-ext-button--large weui-ext-button--secondary login-sheet-secondary-button" disabled="{{loginLoading}}" bindtap="handleCloseLoginModal">
          <view class="weui-ext-button__inner">稍后登录</view>
        </button>
        <button class="weui-btn weui-ext-button weui-ext-button--large weui-ext-button--primary login-sheet-button" loading="{{loginLoading}}" disabled="{{loginLoading}}" bindtap="handleConfirmLogin">
          <view class="weui-ext-button__inner">微信一键登录</view>
        </button>
      </view>
      <mp-cells extClass="login-sheet-consent-cells">
        <mp-checkbox-group extClass="login-sheet-checkbox-group" bind:change="handleToggleLoginAgreement">
          <mp-checkbox
            extClass="login-sheet-checkbox-item"
            value="agree"
            checked="{{loginAgreementChecked}}"
            label="我已阅读并同意"
          />
        </mp-checkbox-group>
      </mp-cells>
      <view class="login-sheet-agreement-links">
        <text class="login-sheet-link" catchtap="handleOpenAgreement">用户协议</text>
        <text class="login-sheet-link-separator">和</text>
        <text class="login-sheet-link" catchtap="handleOpenPrivacy">隐私政策</text>
      </view>
    </view>
  </mp-half-screen-dialog>
</view>
