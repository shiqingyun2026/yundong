<view class="detail-page">
  <mp-toptips id="ui-toptips" root-portal="{{true}}" />
  <view wx:if="{{loading}}" class="page-loading">
    <mp-loading show="{{loading}}" type="dot-gray" />
    <text class="page-loading-text">课程详情加载中...</text>
  </view>

  <scroll-view wx:if="{{!loading && packageDetail}}" class="detail-scroll" scroll-y>
    <view class="hero-swiper-wrap">
      <swiper class="hero-swiper" autoplay circular bindchange="handleHeroSwiperChange">
        <swiper-item wx:for="{{heroImages}}" wx:key="id">
          <image class="hero-image" src="{{item.url}}" mode="aspectFill" data-index="{{index}}" binderror="handleHeroImageError"></image>
        </swiper-item>
      </swiper>
      <view wx:if="{{heroImages.length > 1}}" class="hero-indicator">
        <view
          wx:for="{{heroImages}}"
          wx:key="id"
          class="hero-indicator-dot {{heroCurrent === index ? 'hero-indicator-dot--active' : ''}}"
        ></view>
      </view>
    </view>

    <view class="detail-content">
      <course-overview-sections packageInfo="{{packageDetail}}" showLocationInfo="{{false}}" />

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">当前进行中的拼团</view>
        <view wx:if="{{packageDetail.activeGroups.length}}" class="group-panel">
          <view
            wx:for="{{packageDetail.activeGroups}}"
            wx:key="id"
            class="weui-panel weui-ext-card group-item-card {{item.canJoin ? 'group-item-card--clickable' : 'group-item-card--disabled'}}"
            data-group-id="{{item.id}}"
            data-can-join="{{item.canJoin}}"
            bindtap="handleJoinGroup"
          >
            <view class="group-item-main">
              <view class="group-item-content">
                <view class="group-item-title">
                  <text>{{item.groupTypeLabel}}</text>
                  <text>，每人¥{{item.memberAmountDisplayText || item.memberAmountText}}</text>
                </view>
                <view class="group-progress-caption group-location">地点：{{item.locationText || '待确认'}}</view>
                <view class="group-progress-caption group-schedule">{{item.scheduleText}}</view>
              </view>

              <view class="group-item-side">
                <mp-badge extClass="weui-ext-tag group-item-status group-item-status-ongoing" content="剩余{{item.remainingPlainText}}" />
                <button
                  class="weui-btn weui-ext-button weui-ext-button--medium weui-ext-button--secondary join-button"
                  disabled="{{!item.canJoin}}"
                >
                  <view class="weui-ext-button__inner">{{item.joinButtonText}}</view>
                </button>
              </view>
            </view>
          </view>
        </view>

        <view wx:else class="group-empty">
          <view class="section-desc">暂无进行中的拼团，立即开团吧。</view>
        </view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow group-rules-card">
        <view class="section-title">{{isTrialPackage ? '体验课拼团说明' : '拼团说明'}}</view>
        <view class="notice-list">
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">{{isTrialPackage ? '满员即成团，成团后按所选日期与时间上课。' : '满员即成团，可选择当前进行中的拼团直接加入。'}}</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">拼团截止时间：开团后48小时。</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">{{isTrialPackage ? '体验课仅 1 节，未成团将自动原路退款。' : '未成团退款规则：48小时内未成团将自动原路退款。'}}</view>
          </view>
        </view>
      </view>

      <view class="bottom-space"></view>
    </view>
  </scroll-view>

  <view wx:if="{{!loading && packageDetail}}" class="bottom-bar">
    <button
      class="service-entry service-contact-button"
      open-type="contact"
      bindcontact="handleContact"
    >
      <view class="service-icon">
        <mp-icon extClass="service-icon-image" icon="contacts" type="filled" color="#1abcc5" size="{{28}}" />
      </view>
      <view class="service-text">客服</view>
    </button>
    <button class="service-entry service-share-button" open-type="share">
      <view class="service-icon">
        <image class="service-icon-image service-icon-image--share" src="/assets/icons/wechat-share.svg" mode="aspectFit"></image>
      </view>
      <view class="service-text">分享</view>
    </button>
    <button
      class="weui-btn weui-ext-button weui-ext-button--large weui-ext-button--primary bottom-action"
      bindtap="handleStartGroup"
    >
      <view class="weui-ext-button__inner">立即开团</view>
    </button>
  </view>

  <view wx:if="{{showServiceModal}}" class="service-modal-mask" bindtap="handleCloseService">
    <view class="service-modal-card" catchtap="noop">
      <view class="service-modal-title">请添加客服微信</view>
      <view class="service-qrcode-wrap">
        <image class="service-qrcode" src="/assets/service-wechat-qrcode.jpg" mode="aspectFill"></image>
      </view>
      <button
        class="weui-btn weui-ext-button service-close-button"
        type="button"
        bindtap="handleCloseService"
      >
        <view class="weui-ext-button__inner">关闭</view>
      </button>
    </view>
  </view>

  <login-sheet
    show="{{showLoginSheet}}"
    bind:close="handleCloseLoginSheet"
    bind:success="handleLoginSheetSuccess"
  />
</view>
