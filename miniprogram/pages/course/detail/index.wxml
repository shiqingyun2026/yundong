<view class="detail-page">
  <mp-toptips id="ui-toptips" root-portal="{{true}}" />
  <view wx:if="{{loading}}" class="page-loading">
    <mp-loading show="{{loading}}" type="dot-gray" />
    <text class="page-loading-text">课程详情加载中...</text>
  </view>

  <scroll-view wx:if="{{!loading && packageDetail}}" class="detail-scroll" scroll-y>
    <swiper class="hero-swiper" indicator-dots autoplay circular>
      <swiper-item wx:for="{{packageDetail.images}}" wx:key="*this">
        <image class="hero-image" src="{{item}}" mode="aspectFill"></image>
      </swiper-item>
    </swiper>

    <view class="detail-content">
      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="title-row">
          <view class="course-title">{{packageDetail.name}}</view>
        </view>

        <view wx:if="{{packageDetail.featureTags.length}}" class="feature-tag-list">
          <view wx:for="{{packageDetail.featureTags}}" wx:key="*this" class="feature-tag">{{item}}</view>
        </view>

        <view class="info-list">
          <view class="info-item">
            <view class="info-label">上课地点</view>
            <view class="info-value">{{packageDetail.locationDisplayText || packageDetail.locationText}}</view>
          </view>
          <view class="info-item">
            <view class="info-label">支持拼团</view>
            <view wx:if="{{packageDetail.supportedGroupPriceList.length}}" class="group-price-list">
              <view wx:for="{{packageDetail.supportedGroupPriceList}}" wx:key="count" class="group-price-item">
                <text>{{item.count}}人团</text>
                <text>，每人¥{{item.memberAmountText}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">课程介绍</view>
        <rich-text class="rich-text" nodes="{{packageDetail.description}}"></rich-text>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">教练信息</view>
        <view class="coach-name">{{packageDetail.coachName}}</view>
        <view class="coach-intro">{{packageDetail.coachIntro}}</view>
        <view class="certificate-list">
          <image
            wx:for="{{packageDetail.coachCertificates}}"
            wx:key="*this"
            class="certificate-image"
            src="{{item}}"
            mode="aspectFill"
            data-url="{{item}}"
            bindtap="handlePreviewCertificate"
          ></image>
        </view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow insurance-card">
        <view class="section-title">保险说明</view>
        <view class="section-desc insurance-text">{{packageDetail.insuranceDesc}}</view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">当前进行中的拼团</view>
        <view wx:if="{{packageDetail.activeGroups.length}}" class="group-panel">
          <view wx:for="{{packageDetail.activeGroups}}" wx:key="id" class="weui-panel weui-ext-card group-item-card">
            <view class="group-item-header">
              <view class="group-item-title">
                <text>{{item.targetCount}}人成团</text>
                <text>，每人¥{{item.memberAmountText}}</text>
              </view>
              <mp-badge extClass="weui-ext-tag group-item-status group-item-status-ongoing" content="{{item.remainingText}}" />
            </view>

            <view class="group-item-footer">
              <view class="group-progress-caption group-schedule">{{item.scheduleText}}</view>
              <button
                class="weui-btn weui-ext-button weui-ext-button--medium weui-ext-button--secondary join-button"
                data-group-id="{{item.id}}"
                disabled="{{!item.canJoin}}"
                bindtap="handleJoinGroup"
              >
                <view class="weui-ext-button__inner">{{item.joinButtonText}}</view>
              </button>
            </view>
          </view>
        </view>

        <view wx:else class="group-empty">
          <view class="section-desc">暂无进行中的拼团，立即开团吧。</view>
        </view>
      </view>

      <view class="bottom-space"></view>
    </view>
  </scroll-view>

  <view wx:if="{{!loading && packageDetail}}" class="bottom-bar">
    <view class="service-entry" bindtap="handleOpenService">
      <view class="service-icon">
        <mp-icon extClass="service-icon-image" icon="contacts" type="filled" color="#1abcc5" size="{{28}}" />
      </view>
      <view class="service-text">客服</view>
    </view>
    <button
      class="weui-btn weui-ext-button weui-ext-button--large weui-ext-button--primary bottom-action"
      bindtap="handleStartGroup"
    >
      <view class="weui-ext-button__inner">立即开团</view>
    </button>
  </view>

  <mp-dialog
    wx:if="{{packageDetail}}"
    show="{{showServiceModal}}"
    title="联系客服"
    root-portal="{{true}}"
    extClass="service-dialog"
    buttons="{{serviceDialogButtons}}"
    bind:close="handleCloseService"
    bind:buttontap="handleServiceDialogTap"
  >
    <view class="service-modal-content">
      <view class="service-tip">请联系运营同学获取企业微信二维码。</view>
    </view>
  </mp-dialog>

  <login-sheet
    show="{{showLoginSheet}}"
    bind:close="handleCloseLoginSheet"
    bind:success="handleLoginSheetSuccess"
  />
</view>
