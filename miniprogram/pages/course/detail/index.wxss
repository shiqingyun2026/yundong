.detail-page {
  position: relative;
  min-height: 100vh;
  background: #f7f8fa;
}

.service-contact-button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: normal;
}

.service-contact-button::after {
  border: 0;
}

.detail-scroll {
  height: 100vh;
}

.hero-swiper-wrap {
  position: relative;
}

.hero-swiper {
  width: 100%;
  height: 420rpx;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-indicator {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.68);
  backdrop-filter: blur(12rpx);
}

.hero-indicator-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(26, 188, 197, 0.28);
  transition: all 0.2s ease;
}

.hero-indicator-dot--active {
  width: 28rpx;
  background: var(--brand-primary);
}

.detail-content {
  margin-top: -20rpx;
  padding: 0 24rpx 0;
}

.title-row,
.price-row,
.group-progress-row,
.group-item-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.course-title {
  flex: 1;
  font-size: 38rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.5;
}

.feature-tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.feature-tag {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #eef8f8;
  color: #169ca3;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
}

.info-list {
  margin-top: 28rpx;
}

.info-item + .info-item {
  margin-top: 18rpx;
}

.info-label {
  font-size: 24rpx;
  color: #888888;
}

.info-value {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #353535;
  line-height: 1.7;
}

.group-price-list {
  margin-top: 8rpx;
}

.group-price-item {
  font-size: 28rpx;
  line-height: 1.8;
  color: #1f2329;
}

.rich-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #3c4655;
  line-height: 1.8;
}

.coach-name {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.coach-intro {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #5f6b7a;
}

.certificate-list {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.certificate-image {
  width: 220rpx;
  height: 146rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: #eef2f7;
}

.insurance-card {
  background: linear-gradient(180deg, #ffffff 0%, #f7fbff 100%);
}

.insurance-text {
  margin-top: 16rpx;
  line-height: 1.8;
}

.group-rules-card {
  padding: 28rpx 0;
}

.group-rules-card .section-title {
  padding: 0 32rpx;
  text-align: left;
}

.group-rules-card .notice-list {
  margin-top: 16rpx;
  padding: 0 32rpx;
}

.group-rules-card .notice-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.group-rules-card .notice-item + .notice-item {
  margin-top: 14rpx;
}

.group-rules-card .notice-dot {
  width: 8rpx;
  height: 8rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: var(--brand-primary);
  flex-shrink: 0;
}

.group-rules-card .notice-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.7;
  color: #5f6b7a;
}

.group-panel,
.group-empty {
  margin-top: 20rpx;
}

.group-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.group-item-card {
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1px solid #E5E5E5;
}

.group-item-card--clickable {
  cursor: pointer;
}

.group-item-card--disabled {
  opacity: 0.72;
}

.group-item-main {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 16rpx;
}

.group-item-content {
  flex: 1;
  min-width: 0;
}

.group-item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.6;
}

.group-item-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
}

.weui-ext-tag.group-item-status {
  flex-shrink: 0;
  box-sizing: border-box;
  padding: 0;
  border-radius: 0;
  background: transparent;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
}

.weui-ext-tag.group-item-status-ongoing {
  color: #1f2329;
}

.weui-ext-tag.group-item-status-success {
  background: #ecfbf3;
  color: #18a058;
}

.weui-ext-tag.group-item-status-failed {
  background: #f4f6f8;
  color: #8f96a3;
}

.group-deadline-card {
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid transparent;
}

.group-deadline-normal {
  background: linear-gradient(180deg, #f7fbfb 0%, var(--brand-primary-soft) 100%);
  border-color: rgba(26, 188, 197, 0.14);
}

.group-deadline-warning {
  background: linear-gradient(180deg, #fff8ef 0%, #fff1df 100%);
  border-color: rgba(255, 122, 0, 0.16);
}

.group-deadline-urgent {
  background: linear-gradient(180deg, #fff4f0 0%, #ffe7df 100%);
  border-color: rgba(255, 122, 0, 0.2);
}

.group-deadline-main,
.group-progress-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.group-deadline-label {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.group-deadline-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff7a00;
  box-shadow: 0 0 0 6rpx rgba(255, 122, 0, 0.1);
}

.group-deadline-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #7c5b31;
}

.group-deadline-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}

.group-deadline-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8a6d46;
}

.group-progress-row {
  margin-top: 24rpx;
}

.group-progress-caption {
  font-size: 24rpx;
  color: #8f96a3;
  line-height: 1.6;
}

.group-schedule {
  margin-top: 6rpx;
}

.join-button.weui-btn.weui-ext-button {
  flex-shrink: 0;
  width: 190rpx;
  height: auto;
  min-height: 0;
  min-width: 0;
  margin: 0;
  padding: 8rpx 0;
  border: none;
  border-radius: 20rpx;
  background: rgba(26, 188, 197, 0.1);
  color: #1abcc5;
  font-size: 26rpx;
  line-height: 1.3;
}

.join-button .weui-ext-button__inner {
  white-space: nowrap;
  transform: scale(0.82);
  transform-origin: center;
}

.group-progress-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
}

.progress-track {
  width: 100%;
  height: 16rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #eef2f7;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--brand-primary) 0%, var(--brand-primary-light) 100%);
}

.member-list {
  display: flex;
  margin-top: 24rpx;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  margin-right: -12rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #eef2f7;
}

.bottom-space {
  height: calc(220rpx + env(safe-area-inset-bottom));
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 24rpx rgba(31, 35, 41, 0.06);
}

.service-entry {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.service-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: var(--brand-primary-soft);
}

.service-icon-image {
  width: 28rpx;
  height: 28rpx;
}

.service-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #5f6b7a;
}

.bottom-action {
  flex: 5;
  min-width: 0;
}

.service-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
  animation: service-mask-fade-in 0.3s ease;
}

.service-modal-card {
  width: 600rpx;
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.12);
  animation: service-card-slide-up 0.3s ease;
}

.service-modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #353535;
  line-height: 1.4;
  text-align: center;
}

.service-qrcode-wrap {
  width: 400rpx;
  height: 400rpx;
  margin: 32rpx auto 40rpx;
  padding: 8rpx;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.service-qrcode {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.service-close-button {
  width: 100% !important;
  height: 88rpx !important;
  border: none !important;
  border-radius: 16rpx !important;
  background: #1abcc5 !important;
  color: #ffffff !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
}

.service-close-button::after {
  border: none;
}

@keyframes service-mask-fade-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes service-card-slide-up {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}
