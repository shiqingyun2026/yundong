<view class="group-detail-page">
  <mp-toptips id="ui-toptips" root-portal="{{true}}" />
  <view wx:if="{{loading}}" class="page-loading">
    <mp-loading show="{{loading}}" type="dot-gray" />
    <text class="page-loading-text">拼团详情加载中...</text>
  </view>

  <scroll-view wx:if="{{!loading && groupDetail}}" class="group-scroll" scroll-y>
    <view class="page-shell detail-content">
      <view class="status-header">
        <mp-badge extClass="weui-ext-tag status-tag {{statusClassName}}" content="{{statusText}}" />
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="title-row">
          <view class="course-title">{{groupDetail.packageInfo.name}}</view>
          <mp-badge extClass="weui-ext-tag group-chip" content="{{groupDetail.targetCount}}人成团" />
        </view>

        <view class="price-row">
          <view class="group-price">每人 ¥{{groupDetail.memberAmountText}}</view>
          <mp-badge extClass="weui-ext-tag joined-chip" content="已拼 {{groupDetail.currentCount}} 人" />
        </view>

        <view class="info-list">
          <view class="info-item">
            <view class="info-label">上课时间</view>
            <view class="info-value">{{groupDetail.scheduleMode === 'locked' ? groupDetail.firstClassTimeText : groupDetail.scheduleText}}</view>
          </view>
          <view class="info-item">
            <view class="info-label">上课地点</view>
            <view class="info-value">{{groupDetail.packageInfo.locationText}}</view>
          </view>
          <view class="info-item">
            <view class="info-label">教练</view>
            <view class="info-value">{{groupDetail.packageInfo.coachName}}</view>
          </view>
        </view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">拼团进度</view>
        <view class="progress-header">
          <view class="progress-text">{{groupDetail.currentCount}} / {{groupDetail.targetCount}}</view>
          <view wx:if="{{groupDetail.status === 'active'}}" class="remaining-text">
            {{groupDetail.remainingText}}
          </view>
        </view>
        <view class="progress-track">
          <view class="progress-bar" style="width: {{groupDetail.progressPercent}};"></view>
        </view>
        <view wx:if="{{groupDetail.status !== 'active'}}" class="section-desc progress-desc">
          {{bottomStatusText}}
        </view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">成员列表</view>
        <view wx:if="{{groupDetail.members.length}}" class="member-list-block">
          <view wx:for="{{groupDetail.members}}" wx:key="user_id" class="member-item">
            <image wx:if="{{item.avatar_url}}" class="member-avatar" src="{{item.avatar_url}}" mode="aspectFill"></image>
            <view wx:else class="member-avatar member-avatar--placeholder"></view>
            <view class="member-name">{{item.nickname}}</view>
          </view>
        </view>
        <view wx:else class="section-desc">暂未获取到成员信息</view>
      </view>

      <view wx:if="{{groupDetail.scheduleMode === 'locked' && groupDetail.scheduleList.length}}" class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">5次课时安排</view>
        <view wx:for="{{groupDetail.scheduleList}}" wx:key="index" class="schedule-item">
          <view class="schedule-index">第{{item.index}}次</view>
          <view class="schedule-text">{{item.display_text}}</view>
        </view>
      </view>

      <view class="bottom-space"></view>
    </view>
  </scroll-view>

  <view wx:if="{{!loading && groupDetail}}" class="bottom-bar">
    <block wx:if="{{groupDetail.status === 'active' && groupDetail.userJoined}}">
      <button class="weui-btn weui-ext-button weui-ext-button--large weui-ext-button--primary bottom-button" open-type="share">
        <view class="weui-ext-button__inner">邀请好友</view>
      </button>
    </block>

    <block wx:elif="{{groupDetail.status === 'active' && !groupDetail.userJoined}}">
      <button class="weui-btn weui-ext-button weui-ext-button--large weui-ext-button--primary bottom-button" bindtap="handleJoinGroup">
        <view class="weui-ext-button__inner">立即参团</view>
      </button>
    </block>

    <block wx:else>
      <view class="bottom-status-text">
        {{bottomStatusText}}
      </view>
    </block>
  </view>
</view>
