<view class="group-detail-page">
  <mp-toptips id="ui-toptips" root-portal="{{true}}" />
  <view wx:if="{{loading}}" class="page-loading">
    <mp-loading show="{{loading}}" type="dot-gray" />
    <text class="page-loading-text">拼团详情加载中...</text>
  </view>

  <scroll-view wx:if="{{!loading && groupDetail}}" class="group-scroll" scroll-y>
    <view class="page-shell detail-content">
      <view class="status-header">
        <mp-badge extClass="weui-ext-tag status-tag {{statusClassName}}" content="{{statusText}}" />
        <mp-badge wx:if="{{courseStatusText}}" extClass="weui-ext-tag status-tag status-stage" content="{{courseStatusText}}" />
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="title-row">
          <view class="course-title">{{groupDetail.courseInfo.title}}</view>
          <mp-badge extClass="weui-ext-tag group-chip" content="{{groupDetail.courseInfo.targetCount}}人成团" />
        </view>

        <view class="price-row">
          <view class="group-price">¥{{groupDetail.courseInfo.groupPriceText}}</view>
          <view class="original-price">¥{{groupDetail.courseInfo.originalPriceText}}</view>
          <mp-badge extClass="weui-ext-tag joined-chip" content="已拼 {{groupDetail.currentCount}} 人" />
        </view>

        <view class="info-list">
          <view class="info-item">
            <view class="info-label">上课时间</view>
            <view class="info-value">{{groupDetail.courseInfo.timeText}}</view>
          </view>
          <view class="info-item">
            <view class="info-label">上课地点</view>
            <view class="info-value">{{groupDetail.courseInfo.locationText}}</view>
          </view>
          <view class="info-item">
            <view class="info-label">适用年龄</view>
            <view class="info-value">{{groupDetail.courseInfo.ageRange}}</view>
          </view>
        </view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">拼团进度</view>
        <view class="progress-header">
          <view class="progress-text">{{groupDetail.progressText}}</view>
          <view wx:if="{{groupDetail.status === 'ongoing'}}" class="remaining-text">
            {{groupDetail.expireTimeText}}
          </view>
        </view>
        <view class="progress-track">
          <view class="progress-bar" style="width: {{groupDetail.progressPercent}};"></view>
        </view>
        <view wx:if="{{groupDetail.status !== 'ongoing'}}" class="section-desc progress-desc">
          {{progressStatusText}}
        </view>
      </view>

      <view class="bottom-space"></view>
    </view>
  </scroll-view>

  <view wx:if="{{!loading && groupDetail}}" class="bottom-bar">
    <block wx:if="{{groupDetail.status === 'ongoing' && groupDetail.userJoined}}">
      <button class="weui-btn weui-ext-button weui-ext-button--large weui-ext-button--primary bottom-button" open-type="share">
        <view class="weui-ext-button__inner">邀请好友</view>
      </button>
    </block>

    <block wx:elif="{{groupDetail.status === 'ongoing' && !groupDetail.userJoined}}">
      <button class="weui-btn weui-ext-button weui-ext-button--large weui-ext-button--primary bottom-button" bindtap="handleJoinGroup">
        <view class="weui-ext-button__inner">立即参团</view>
      </button>
    </block>

    <block wx:else>
      <view class="bottom-status-text">
        {{bottomStatusText}}
      </view>
    </block>
  </view>
</view>
