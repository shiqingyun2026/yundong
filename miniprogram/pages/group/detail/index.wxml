<view class="group-detail-page">
  <mp-toptips id="ui-toptips" root-portal="{{true}}" />
  <view wx:if="{{loading}}" class="page-loading">
    <mp-loading show="{{loading}}" type="dot-gray" />
    <text class="page-loading-text">拼团详情加载中...</text>
  </view>

  <scroll-view wx:if="{{!loading && groupDetail}}" class="group-scroll" scroll-y>
    <view class="page-shell detail-content">
      <view wx:if="{{showSuccessEntry}}" class="weui-panel weui-ext-card page-section card-shadow success-entry-card">
        <view class="success-entry-icon">✓</view>
        <view class="success-entry-status">{{successSummaryText}}</view>

        <view wx:if="{{groupDetail.status === 'active'}}" class="success-highlight-row">
          <view class="success-progress-line">
            <view class="success-progress-track">
              <view class="success-progress-bar" style="width: {{groupDetail.progressPercent}};"></view>
            </view>
            <view class="success-progress-count">{{groupDetail.currentCount}}/{{groupDetail.targetCount}}</view>
          </view>
          <view class="success-countdown-row">
            <image class="success-countdown-icon" src="/assets/icons/status-info-primary.svg" mode="aspectFit"></image>
            <view class="success-countdown-text">剩余 {{groupDetail.remainingPlainText}}</view>
          </view>
        </view>

        <button
          wx:if="{{groupDetail.status === 'active' && groupDetail.userJoined}}"
          class="weui-btn weui-ext-button weui-ext-button--large weui-ext-button--primary success-primary-button"
          open-type="share"
        >
          <view class="weui-ext-button__inner">邀请好友参团</view>
        </button>

        <button
          wx:if="{{showSubscribeCard}}"
          class="weui-btn weui-ext-button weui-ext-button--large success-secondary-button"
          loading="{{subscribeSubmitting}}"
          disabled="{{subscribeSubmitting || subscribed || !subscribeEnabled}}"
          bindtap="handleSubscribeTap"
        >
          <view class="weui-ext-button__inner">
            {{subscribed ? '已订阅拼团通知' : (subscribeSubmitting ? '订阅中...' : '订阅拼团通知')}}
          </view>
        </button>

        <view wx:if="{{showSubscribeCard && subscribeStatusText}}" class="subscribe-status {{subscribeStatusTone === 'success' ? 'subscribe-status-success' : 'subscribe-status-muted'}}">
          {{subscribeStatusText}}
        </view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow course-info-card">
        <view class="course-title">{{groupDetail.packageInfo.name}}</view>
        <view class="group-tag-row">
          <view class="group-price-tag">{{groupDetail.targetCount}}人成团</view>
          <view class="group-price-tag">每人 ¥{{groupDetail.memberAmountDisplayText || groupDetail.memberAmountText}}</view>
        </view>

        <view class="info-list">
          <view class="info-row">
            <view class="info-icon">📅</view>
            <view class="info-value">{{groupDetail.scheduleMode === 'locked' ? groupDetail.firstClassTimeText : groupDetail.scheduleText}}</view>
          </view>
          <view class="info-row">
            <view class="info-icon">📍</view>
            <view class="info-value">{{groupDetail.packageInfo.locationText}}</view>
          </view>
        </view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow group-rules-card">
        <view class="section-title">拼团说明</view>
        <view class="section-desc">· 满员即成团</view>
        <view class="section-desc">· 拼团截止时间：开团后48小时</view>
        <view class="section-desc">· 未成团退款规则：48小时内容未成团将自动原路退款</view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow notice-card">
        <view class="section-title">上课注意事项</view>
        <view class="section-desc notice-item">· 开团后，按固定课时进行上课。</view>
        <view class="section-desc notice-item">· 极端天气，课程顺延至下周。</view>
        <view class="section-desc notice-item">· 请假人数过半，课程顺延至下周，个人请假，不退费不补课。</view>
        <view class="section-desc notice-item">· 上课期间，课程不得转让，不可更换学员。</view>
        <view class="section-desc notice-item">· 饭后至少半个小时再运动，请家长提前做好安排。</view>
        <view class="section-desc notice-item">· 上课前替换换好运动服和运动鞋，并准备好饮用水。</view>
        <view class="section-desc notice-item">· 如学员有特殊情况，请提前告知。</view>
        <view class="section-desc notice-item">· 每次上课，至少要求一个家长全程在场。</view>
        <view class="section-desc notice-item">· 建议家长提前给孩子购买意外险。</view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">成员列表</view>
        <view wx:if="{{groupDetail.members.length}}" class="member-list-block">
          <view wx:for="{{groupDetail.members}}" wx:key="user_id" class="member-item">
            <image class="member-avatar" src="{{item.avatar_url}}" mode="aspectFill"></image>
            <view class="member-name">{{item.displayText || item.displayName || item.nickname}}</view>
          </view>
        </view>
        <view wx:else class="section-desc">暂未获取到成员信息</view>
      </view>

      <view wx:if="{{groupDetail.scheduleMode === 'locked' && groupDetail.scheduleList.length}}" class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">5次课时安排</view>
        <view class="schedule-list">
          <view wx:for="{{groupDetail.scheduleList}}" wx:key="index" class="schedule-item">
            <view class="schedule-index">第{{item.index}}次</view>
            <view class="schedule-text">{{item.display_text}}</view>
          </view>
        </view>
      </view>

      <view class="bottom-space {{showSuccessEntry ? 'bottom-space--success-entry' : ''}}"></view>
    </view>
  </scroll-view>

  <view wx:if="{{!loading && groupDetail && !showSuccessEntry}}" class="bottom-bar">
    <block wx:if="{{showPrimaryShareAction}}">
      <button class="weui-btn weui-ext-button weui-ext-button--large weui-ext-button--primary bottom-button" open-type="share">
        <view class="weui-ext-button__inner">邀请好友参团</view>
      </button>
    </block>

    <block wx:elif="{{showJoinAction}}">
      <button class="weui-btn weui-ext-button weui-ext-button--large weui-ext-button--primary bottom-button" bindtap="handleJoinGroup">
        <view class="weui-ext-button__inner">立即参团</view>
      </button>
    </block>

    <block wx:else>
      <view class="bottom-status-text">
        {{bottomStatusText}}
      </view>
    </block>
  </view>
</view>
