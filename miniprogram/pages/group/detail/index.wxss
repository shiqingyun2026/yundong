.group-detail-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f7f8fa;
}

.group-scroll {
  flex: 1;
  height: 100vh;
}

.detail-content {
  padding-top: 20rpx;
  padding-bottom: 0;
}

.success-entry-card {
  padding: 32rpx 24rpx 28rpx;
  text-align: center;
  background: #ffffff;
}

.success-entry-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: var(--brand-primary-soft);
  color: var(--brand-primary);
  font-size: 56rpx;
  font-weight: 700;
}

.success-entry-title,
.success-entry-status {
  margin-top: 18rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.35;
}

.success-entry-status {
  font-size: 34rpx;
  white-space: nowrap;
}

.success-entry-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #5f6b7a;
}

.success-highlight-row {
  display: block;
  margin-top: 24rpx;
  text-align: center;
}

.success-progress-line {
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
}

.success-progress-track {
  flex: 1;
  min-width: 0;
  height: 16rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #f0f0f0;
}

.success-progress-bar {
  height: 100%;
  border-radius: 8rpx;
  background: #1abcc5;
}

.success-progress-count {
  flex-shrink: 0;
  min-width: 72rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #353535;
  line-height: 1.4;
  text-align: right;
}

.success-countdown-row {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
  gap: 8rpx;
}

.success-countdown-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.success-countdown-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #f56c6c;
  line-height: 1.45;
  text-align: center;
}

.success-primary-button {
  width: 100% !important;
  height: 88rpx !important;
  margin-top: 28rpx !important;
  border-radius: 16rpx !important;
}

.success-secondary-button {
  width: 100% !important;
  height: 88rpx !important;
  margin-top: 16rpx !important;
  border: 2rpx solid var(--brand-primary-border) !important;
  border-radius: 16rpx !important;
  background: #ffffff !important;
  color: var(--brand-primary) !important;
}

.group-detail-page .group-rules-card {
  padding: 28rpx 0;
}

.group-detail-page .group-rules-card .section-title,
.group-detail-page .group-rules-card .section-desc {
  padding: 0 32rpx;
  text-align: left;
}

.group-detail-page .group-rules-card .section-desc {
  margin-top: 12rpx;
}

.group-detail-page .notice-card {
  padding: 28rpx 0;
}

.group-detail-page .notice-card .section-title,
.group-detail-page .notice-card .section-desc {
  padding: 0 32rpx;
  text-align: left;
}

.group-detail-page .notice-card .notice-item {
  margin-top: 14rpx;
}

.title-row,
.progress-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.course-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.45;
}

.group-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
}

.group-price-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--brand-primary-soft);
  color: var(--brand-primary);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
}

.info-list {
  margin-top: 24rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.info-row + .info-row {
  margin-top: 18rpx;
}

.info-icon {
  width: 36rpx;
  flex-shrink: 0;
  padding-top: 2rpx;
  font-size: 28rpx;
  line-height: 1.45;
  text-align: center;
}

.info-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #8a8f98;
  line-height: 1.45;
  text-align: left;
}

.progress-text,
.remaining-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
}

.remaining-text {
  color: #5f6b7a;
}

.progress-track {
  width: 100%;
  height: 18rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e5e5e5;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: var(--brand-primary);
}

.progress-desc {
  margin-top: 18rpx;
}

.member-list-block {
  margin-top: 20rpx;
}

.member-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.member-item + .member-item {
  margin-top: 16rpx;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eef2f7;
}

.member-avatar--placeholder {
  background: linear-gradient(135deg, var(--brand-primary-soft) 0%, #eef2f7 100%);
}

.member-name {
  font-size: 28rpx;
  color: #1f2329;
}

.schedule-list {
  margin-top: 16rpx;
  border-top: 1px solid #f7f7f7;
  border-bottom: 1px solid #f7f7f7;
  border-radius: 16rpx;
  overflow: hidden;
  background: #ffffff;
}

.schedule-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 88rpx;
  margin-top: 0;
  padding: 0 32rpx;
  border: none;
  background: #ffffff;
}

.schedule-item + .schedule-item {
  border-top: 1px solid #f7f7f7;
}

.schedule-index {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 500;
  color: #353535;
  line-height: 1.4;
}

.schedule-text {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #353535;
  line-height: 1.4;
}

.bottom-space {
  height: 184rpx;
}

.bottom-space--success-entry {
  height: 32rpx;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0 calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 24rpx rgba(31, 35, 41, 0.06);
}

.bottom-button {
  width: calc(100% - 64rpx) !important;
  margin: 0 32rpx !important;
  height: 96rpx !important;
  padding: 0 !important;
  border-radius: 16rpx !important;
  background: var(--brand-primary) !important;
  color: #ffffff !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  box-shadow: 0 8rpx 24rpx var(--brand-primary-shadow-strong);
}

.bottom-button::after {
  border: none;
  border-radius: 16rpx;
}

.bottom-status-text {
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #5f6b7a;
}

.subscribe-status {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  text-align: left;
}

.subscribe-status-success {
  color: var(--brand-primary);
}

.subscribe-status-muted {
  color: #86909c;
}
