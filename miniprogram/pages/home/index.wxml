<view
  class="page-shell home-page"
  style="--home-nav-body-height: {{navBarBodyHeight}}px;"
>
  <mp-toptips id="ui-toptips" root-portal="{{true}}" />
  <view class="home-navbar">
    <mp-navigation-bar extClass="home-nav-bar" background="transparent" color="#1f2329" back="{{false}}">
      <view slot="left" class="home-navbar-row">
        <view class="location-pill navbar-location-pill" bindtap="handleLocationTap">
          <text class="location-text">{{locationText}}</text>
          <text class="location-chevron">›</text>
        </view>
      </view>
    </mp-navigation-bar>
  </view>

  <view wx:if="{{showBannerSwiper && bannerList.length}}" class="banner-panel card-shadow">
    <swiper
      class="banner-swiper"
      indicator-dots="{{false}}"
      autoplay="{{true}}"
      circular="{{bannerList.length > 1}}"
      interval="3800"
      duration="360"
      bindanimationfinish="handleBannerChange"
    >
      <swiper-item wx:for="{{bannerList}}" wx:key="renderKey">
        <view class="banner-slide banner-slide--{{item.theme}}" data-index="{{index}}" bindtap="handleBannerTap">
          <image
            wx:if="{{item.image}}"
            class="banner-image"
            src="{{item.image}}"
            mode="aspectFill"
            data-id="{{item.id}}"
            bindload="handleBannerImageLoad"
            binderror="handleBannerImageError"
          />
          <view class="banner-overlay">
            <view wx:if="{{item.kicker}}" class="banner-kicker">{{item.kicker}}</view>
            <view wx:if="{{item.desc}}" class="banner-desc">{{item.desc}}</view>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <view wx:if="{{bannerList.length > 1}}" class="banner-dots">
      <view
        wx:for="{{bannerList}}"
        wx:key="id"
        class="banner-dot {{index === activeBannerIndex ? 'banner-dot--active' : ''}}"
      ></view>
    </view>
  </view>

  <view wx:if="{{locationTip}}" class="weui-panel weui-ext-card notice-card card-shadow">
    <view class="notice-text">{{locationTip}}</view>
    <view wx:if="{{locationDenied}}" class="notice-action" bindtap="handleManualLocationTip">
      开启定位
    </view>
  </view>

  <view wx:if="{{initialLoading}}" class="page-loading">
    <mp-loading show="{{initialLoading}}" type="dot-gray" />
    <text class="page-loading-text">课程加载中...</text>
  </view>

  <view wx:if="{{!initialLoading}}" class="content-panel card-shadow">
    <scroll-view class="tab-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="course-tabs">
        <view
          wx:for="{{tabs}}"
          wx:key="key"
          class="course-tab {{activeTab === item.key ? 'course-tab--active' : ''}}"
          data-key="{{item.key}}"
          bindtap="handleTabChange"
        >
          <text class="course-tab__label">{{item.label}}</text>
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{packageList.length}}" class="course-list">
      <view
        class="weui-panel weui-ext-card course-card"
        wx:for="{{packageList}}"
        wx:key="id"
        data-id="{{item.id}}"
        bind:tap="handleCourseTap"
      >
        <view class="cover-wrap" data-id="{{item.id}}" catchtap="handleCourseTap">
          <image
            wx:if="{{item.cover && !item.coverLoadFailed}}"
            class="course-cover"
            src="{{item.cover}}"
            mode="aspectFill"
            data-id="{{item.id}}"
            binderror="handleCourseCoverError"
          ></image>
          <view wx:else class="course-cover course-cover-fallback">
            <view class="cover-fallback-kicker">天天体育宝</view>
            <view class="cover-fallback-title">{{item.packageCategory || '体适能'}}课程</view>
            <view class="cover-fallback-desc">5次连续训练计划</view>
          </view>
        </view>

        <view class="course-content" data-id="{{item.id}}" catchtap="handleCourseTap">
          <view class="course-title-row">
            <view class="course-title">{{item.name}}</view>
            <mp-badge
              wx:if="{{item.distanceText || item.locationDistrict}}"
              extClass="weui-ext-tag distance-text"
              content="{{item.distanceText || item.locationDistrict}}"
            />
          </view>

          <view class="course-meta">{{item.locationText}}</view>

          <view class="course-footer">
            <view class="price-group">
              <view class="group-price">
                <text class="group-price__amount">{{item.perMemberText}}</text>
                <text class="group-price__suffix">起</text>
              </view>
              <view wx:if="{{item.classCountTagText}}" class="class-count-tag">{{item.classCountTagText}}</view>
              <view wx:if="{{item.showLimitedTimeOfferTag}}" class="limited-offer-tag">限时特惠</view>
            </view>
            <view class="joined-text">立即查看</view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{!packageList.length}}" class="page-empty">
      <view class="page-empty-illustration"></view>
      <mp-msg
        extClass="page-empty-msg"
        title="暂无可展示课程"
        desc="下拉刷新后再试，或切换筛选条件查看。"
      />
    </view>
  </view>

  <view wx:if="{{!initialLoading && packageList.length}}" class="list-footer">
    <block wx:if="{{loading}}">
      <view class="footer-text">加载中...</view>
    </block>
    <block wx:elif="{{!hasMore}}">
      <view class="footer-text">课程正在逐渐开放中</view>
    </block>
    <block wx:else>
      <view class="footer-text">上拉加载更多</view>
    </block>
  </view>
</view>
