<view
  class="page-shell home-page"
  style="--home-nav-body-height: {{navBarBodyHeight}}px;"
>
  <mp-toptips id="ui-toptips" root-portal="{{true}}" />
  <view class="home-navbar">
    <mp-navigation-bar extClass="home-nav-bar" background="transparent" color="#1f2329" back="{{false}}">
      <view slot="left" class="home-navbar-row">
        <view class="location-pill navbar-location-pill" bindtap="handleLocationTap">
          <text class="location-text">{{locationText}}</text>
          <text class="location-chevron">›</text>
        </view>
      </view>
    </mp-navigation-bar>
  </view>

  <view class="weui-panel weui-ext-card hero-card card-shadow">
    <view class="hero-tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="hero-tab {{activeTab === item.key ? 'hero-tab--active' : ''}}"
        data-key="{{item.key}}"
        bindtap="handleTabChange"
      >
        <text class="hero-tab__label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{locationTip}}" class="weui-panel weui-ext-card notice-card card-shadow">
    <view class="notice-text">{{locationTip}}</view>
    <view wx:if="{{locationDenied}}" class="notice-action" bindtap="handleManualLocationTip">
      开启定位
    </view>
  </view>

  <view wx:if="{{initialLoading}}" class="page-loading">
    <mp-loading show="{{initialLoading}}" type="dot-gray" />
    <text class="page-loading-text">课程加载中...</text>
  </view>

  <view wx:if="{{!initialLoading && courseList.length}}" class="course-list">
    <view
      class="weui-panel weui-ext-card course-card card-shadow"
      wx:for="{{courseList}}"
      wx:key="id"
      data-id="{{item.id}}"
      bind:tap="handleCourseTap"
    >
      <view class="cover-wrap">
        <image class="course-cover" src="{{item.cover}}" mode="aspectFill"></image>
        <mp-badge wx:if="{{item.soonGroup}}" extClass="weui-ext-tag group-tag" content="即将成团" />
      </view>

      <view class="course-content">
        <view class="course-title-row">
          <view class="course-title">{{item.title}}</view>
          <mp-badge wx:if="{{activeTab === 'all'}}" extClass="weui-ext-tag distance-text" content="{{item.distanceText}}" />
        </view>

        <view class="course-meta">{{item.timeText}}</view>
        <view class="course-meta">{{item.locationText}}</view>
        <mp-badge wx:if="{{item.showActiveGroupCountdown}}" extClass="weui-ext-tag countdown-pill" content="{{item.activeGroup.expireTimeText}}" />

        <view class="course-footer">
          <view class="price-group">
            <view class="group-price">¥{{item.groupPriceText}}</view>
            <view class="original-price">¥{{item.originalPriceText}}</view>
          </view>
          <view class="footer-status">
            <view wx:if="{{item.showSuccessBadge}}" class="success-text">已拼团成功</view>
            <view wx:if="{{item.showJoinedCount}}" class="joined-text">已拼 {{item.displayJoinedCount}} 人</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!initialLoading && !courseList.length}}" class="page-empty">
    <view class="page-empty-illustration"></view>
    <mp-msg
      extClass="page-empty-msg"
      title="暂无可展示课程"
      desc="下拉刷新后再试，或稍后切换筛选条件查看。"
    />
  </view>

  <view wx:if="{{!initialLoading && courseList.length}}" class="list-footer">
    <block wx:if="{{loading}}">
      <view class="footer-text">加载中...</view>
    </block>
    <block wx:elif="{{!hasMore}}">
      <view class="footer-text">没有更多课程了</view>
    </block>
    <block wx:else>
      <view class="footer-text">上拉加载更多</view>
    </block>
  </view>
</view>
