.home-page {
  padding-top: 0;
  padding-bottom: 40rpx;
}

.home-navbar {
  margin: 0 -24rpx;
  padding: 0 24rpx 18rpx;
  background: linear-gradient(180deg, #f7f8fa 0%, #f7f8fa 70%, rgba(247, 248, 250, 0) 100%);
}

.home-navbar-row {
  display: flex;
  align-items: center;
  min-height: var(--home-nav-body-height);
  box-sizing: border-box;
}

.hero-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fff8ef 48%, var(--brand-primary-soft) 100%);
}

.hero-copy {
  margin-bottom: 20rpx;
}

.hero-kicker {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #8f96a3;
}

.hero-title {
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #1f2329;
}

.hero-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5f6b7a;
}

.location-pill {
  display: flex;
  align-items: center;
  min-height: var(--home-nav-body-height);
  max-width: 520rpx;
  padding: 8rpx 0;
}

.navbar-location-pill {
  max-width: 520rpx;
}

.location-chevron {
  margin-left: 12rpx;
  color: #000000;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
  flex-shrink: 0;
}

.location-text {
  overflow: hidden;
  color: #000000;
  font-size: 30rpx;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hero-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hero-tab {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 72rpx;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: #eef2f7;
  color: #5f6b7a;
  text-align: center;
  font-size: 26rpx;
  transition: background-color 160ms ease, box-shadow 160ms ease, color 160ms ease;
}

.hero-tab__label {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  text-align: center;
  line-height: 1.2;
  white-space: nowrap;
}

.hero-tab--active {
  background: #18bcc5;
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(24, 188, 197, 0.18);
}

.notice-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.notice-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5f6b7a;
}

.notice-action {
  color: var(--brand-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.course-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.course-card {
  overflow: hidden;
  border-radius: 32rpx;
  background: #ffffff;
}

.cover-wrap {
  position: relative;
}

.course-cover {
  display: block;
  width: 100%;
  height: 280rpx;
  background: #eef2f7;
}

.group-tag {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  max-width: calc(100% - 40rpx);
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 0, 0.92);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
}

.course-content {
  padding: 28rpx;
}

.course-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.course-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.5;
  color: #1f2329;
}

.distance-text {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f5f7fb;
  color: #5f6b7a;
  font-size: 22rpx;
}

.course-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #8f96a3;
}

.course-footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
}

.price-group {
  display: flex;
  align-items: flex-end;
  gap: 0;
}

.group-price {
  color: #ff7a00;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.joined-text {
  color: var(--brand-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.list-footer {
  padding: 28rpx 0 16rpx;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: #8f96a3;
}
