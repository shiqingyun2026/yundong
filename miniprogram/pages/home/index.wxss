.home-page {
  padding-top: 0;
  padding-bottom: 40rpx;
}

.home-navbar {
  margin: 0 -24rpx;
  padding: 0 24rpx 18rpx;
  background: linear-gradient(180deg, #f7f8fa 0%, #f7f8fa 70%, rgba(247, 248, 250, 0) 100%);
}

.home-navbar-row {
  display: flex;
  align-items: center;
  min-height: var(--home-nav-body-height);
  box-sizing: border-box;
}

.location-pill {
  display: flex;
  align-items: center;
  min-height: var(--home-nav-body-height);
  max-width: 520rpx;
  padding: 8rpx 0;
}

.navbar-location-pill {
  max-width: 520rpx;
}

.location-chevron {
  margin-left: 12rpx;
  color: #353535;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
  flex-shrink: 0;
}

.location-text {
  overflow: hidden;
  color: #353535;
  font-size: 30rpx;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.banner-panel {
  position: relative;
  margin-bottom: 24rpx;
  padding: 0;
  overflow: hidden;
  border-radius: 36rpx;
  background: #ffffff;
}

.banner-swiper {
  width: 100%;
  height: 304rpx;
}

.banner-slide {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #d8efff 0%, #eef7ff 100%);
}

.banner-slide--teal {
  background: linear-gradient(135deg, #17b4b9 0%, #5ad0d4 55%, #c9f2f1 100%);
}

.banner-slide--cream {
  background: linear-gradient(135deg, #feeccc 0%, #fdf7ea 100%);
}

.banner-slide--blue {
  background: linear-gradient(135deg, #dae9ff 0%, #f4f8ff 100%);
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 36rpx 40rpx;
  background:
    linear-gradient(90deg, rgba(18, 28, 45, 0.26) 0%, rgba(18, 28, 45, 0.08) 44%, rgba(18, 28, 45, 0) 100%);
  color: #ffffff;
}

.banner-kicker {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  opacity: 0.86;
}

.banner-title {
  margin-top: 14rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}

.banner-desc {
  margin-top: 14rpx;
  max-width: 420rpx;
  font-size: 22rpx;
  line-height: 1.6;
  opacity: 0.9;
}

.banner-dots {
  position: absolute;
  left: 50%;
  bottom: 18rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  transform: translateX(-50%);
}

.banner-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.46);
  transition: all 180ms ease;
}

.banner-dot--active {
  width: 30rpx;
  background: #ffffff;
}

.notice-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.notice-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5f6b7a;
}

.notice-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
  padding: 0 16rpx;
  color: var(--brand-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.content-panel {
  padding: 18rpx;
  border-radius: 36rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fcfcfd 100%);
}

.tab-scroll {
  width: 100%;
}

.course-tabs {
  display: inline-flex;
  min-width: 100%;
  gap: 16rpx;
  padding: 8rpx 6rpx 22rpx;
}

.course-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 150rpx;
  min-height: 74rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #f0f2f6;
  color: #667085;
  transition: background-color 160ms ease, box-shadow 160ms ease, color 160ms ease;
}

.course-tab__label {
  font-size: 28rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.course-tab--active {
  background: var(--brand-primary);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(26, 188, 197, 0.22);
}

.course-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.course-card {
  overflow: hidden;
  border-radius: 32rpx;
  background: #ffffff;
  border: 2rpx solid #f3f4f6;
  box-shadow: 0 10rpx 26rpx rgba(31, 35, 41, 0.05);
}

.cover-wrap {
  position: relative;
}

.course-cover {
  display: block;
  width: 100%;
  height: 280rpx;
  background: #eef2f7;
}

.course-cover-fallback {
  box-sizing: border-box;
  padding: 44rpx 36rpx;
  background:
    radial-gradient(circle at 82% 18%, rgba(255, 190, 94, 0.55) 0, rgba(255, 190, 94, 0) 30%),
    linear-gradient(135deg, #e8fbf9 0%, #dff3ff 48%, #fff2df 100%);
  color: #16484f;
}

.cover-fallback-kicker {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  font-weight: 600;
}

.cover-fallback-title {
  margin-top: 40rpx;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
}

.cover-fallback-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(22, 72, 79, 0.72);
}

.group-tag {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  max-width: calc(100% - 40rpx);
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(34, 40, 49, 0.12);
  color: #434b57;
  font-size: 22rpx;
  font-weight: 600;
}

.course-content {
  padding: 28rpx;
}

.course-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.course-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.5;
  color: #1f2329;
}

.distance-text {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f5f7fb;
  color: #5f6b7a;
  font-size: 22rpx;
}

.course-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #8f96a3;
}

.course-footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
}

.group-price {
  display: inline-flex;
  align-items: flex-end;
}

.group-price__amount {
  color: #ff7a00;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.group-price__suffix {
  margin-left: 6rpx;
  color: #ff7a00;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.1;
}

.price-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.group-price {
  color: #ff7a00;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.class-count-tag {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(26, 188, 197, 0.12);
  color: #179ca3;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.joined-text {
  color: var(--brand-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.list-footer {
  padding: 28rpx 0 16rpx;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: #8f96a3;
}
