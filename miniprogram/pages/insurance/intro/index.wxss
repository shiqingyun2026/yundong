.insurance-page {
  height: 100vh;
  background: #f5f7fc;
}

.insurance-container {
  padding: 24rpx;
}

.insurance-card {
  margin-bottom: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 43, 63, 0.05);
}

.insurance-card--hero {
  position: relative;
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
}

.hero-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.brand-logo {
  display: flex;
  flex-shrink: 0;
  align-items: flex-end;
}

.brand-logo-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.product-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #1f3e68;
}

.product-tag {
  display: inline-flex;
  margin-top: 14rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #29578f;
  font-size: 22rpx;
  font-weight: 600;
}

.note-box {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-left: 6rpx solid #f9b43a;
  border-radius: 16rpx;
  background: #fef9e6;
}

.note-line {
  font-size: 24rpx;
  line-height: 1.8;
  color: #5e5a47;
}

.section-title {
  padding-left: 16rpx;
  border-left: 6rpx solid #2c6eaf;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.5;
  color: #0f2b3f;
}

.benefit-section + .benefit-section {
  margin-top: 28rpx;
}

.sub-title {
  margin-top: 20rpx;
  margin-bottom: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
  color: #2c5a8c;
}

.benefit-grid {
  overflow: hidden;
  border: 1rpx solid #eef2f6;
  border-radius: 20rpx;
}

.benefit-row {
  display: flex;
  align-items: stretch;
  border-bottom: 1rpx solid #eef2f6;
}

.benefit-row:last-child {
  border-bottom: 0;
}

.benefit-name {
  flex: 1;
  padding: 20rpx 18rpx;
  background: #fafcff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.6;
  color: #1e2f44;
}

.benefit-amount {
  min-width: 180rpx;
  padding: 20rpx 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.6;
  color: #1e466e;
  text-align: right;
}

.fact-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  background: #f8fafe;
}

.fact-item {
  flex: 1;
  min-width: 180rpx;
}

.fact-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #25384d;
}

.fact-value {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #4e6278;
}

.detail-item + .detail-item {
  margin-top: 8rpx;
}

.detail-desc {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f9fafc;
  font-size: 25rpx;
  line-height: 1.8;
  color: #2c3f4f;
}

.reminder-box {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #edf2f9;
  font-size: 24rpx;
  line-height: 1.8;
  color: #44566d;
}

.insurance-card--footnote {
  margin-bottom: 40rpx;
}

.footnote-text {
  font-size: 22rpx;
  line-height: 1.8;
  color: #6b7a8a;
}
