.location-search-page {
  min-height: 100vh;
  background: #f7f8fa;
}

.page-header {
  padding-bottom: 12rpx;
  background: #f7f8fa;
}

.header-back,
.header-space {
  width: 64rpx;
  height: var(--location-nav-body-height);
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.header-back-icon {
  width: 16rpx;
  height: 16rpx;
}

.header-title {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--location-nav-body-height);
  box-sizing: border-box;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}

.header-content {
  padding: 0 24rpx;
}

.search-shell {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 12rpx;
  padding: 12rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #eceff3;
}

.city-pill {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
  color: #1f2329;
  font-size: 26rpx;
  font-weight: 500;
  white-space: nowrap;
}

.city-arrow {
  margin-left: 8rpx;
  color: #8f96a3;
  font-size: 18rpx;
}

.search-box {
  flex: 1 1 auto;
  display: flex;
  align-items: center;
  height: 64rpx;
  min-width: 0;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
  overflow: hidden;
}

.search-icon {
  width: 18rpx;
  height: 18rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  min-width: 0;
  width: 100%;
  height: 40px;
  margin-left: 12rpx;
  color: #1f2329;
  font-size: 26rpx;
}

.search-placeholder {
  color: #a0a7b4;
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  margin-left: 8rpx;
  border-radius: 18rpx;
  background: #d7dbe2;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
  flex-shrink: 0;
}

.page-body {
  padding: 0 24rpx 32rpx;
}

.current-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 80rpx;
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #eceff3;
}

.current-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: rgba(26, 188, 197, 0.1);
}

.current-icon-image {
  width: 24rpx;
  height: 24rpx;
}

.current-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.current-label {
  flex-shrink: 0;
  color: #1abcc5;
  font-size: 24rpx;
  font-weight: 500;
}

.current-action {
  flex-shrink: 0;
  color: #1abcc5;
  font-size: 24rpx;
  font-weight: 500;
}

.state-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx 80rpx;
  text-align: center;
}

.state-spinner,
.state-empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: rgba(26, 188, 197, 0.08);
}

.state-spinner-icon,
.state-empty-icon-image {
  width: 60rpx;
  height: 60rpx;
}

.state-spinner-icon {
  animation: ant-icon-spin 1s linear infinite;
}

.state-title {
  margin-top: 28rpx;
  color: #1f2329;
  font-size: 32rpx;
  font-weight: 600;
}

.state-desc {
  margin-top: 14rpx;
  color: #8f96a3;
  font-size: 24rpx;
  line-height: 1.7;
}

.result-section {
  margin-top: 12rpx;
}

.result-card {
  display: flex;
  align-items: center;
  min-height: 84rpx;
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #eceff3;
}

.result-content {
  flex: 1;
  min-width: 0;
}

.result-name {
  color: #1f2329;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-address {
  margin-top: 6rpx;
  color: #8f96a3;
  font-size: 22rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-meta {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.distance-text {
  color: #8f96a3;
  font-size: 22rpx;
  line-height: 1;
}

@keyframes ant-icon-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}
