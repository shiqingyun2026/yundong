<view class="page-shell mine-page">
  <mp-toptips id="ui-toptips" root-portal="{{true}}" />
  <view class="weui-panel weui-ext-card profile-card card-shadow {{!userInfo ? 'profile-card-guest' : ''}}" bindtap="handleProfileTap">
    <view class="profile-main">
      <view class="avatar-box {{!userInfo ? 'avatar-box-guest' : ''}}">
        <view class="avatar-placeholder">
          <mp-icon
            extClass="avatar-placeholder-icon"
            icon="me"
            type="filled"
            color="#ffffff"
            size="{{userInfo ? 44 : 53}}"
          />
        </view>
      </view>
      <view class="profile-info">
        <view class="profile-name {{!userInfo ? 'profile-name-guest' : ''}}">{{userInfo ? userInfo.nickName : (loginLoading ? '登录中...' : '立即登录')}}</view>
      </view>
    </view>

    <button
      wx:if="{{userInfo}}"
      class="weui-btn weui-ext-button weui-ext-button--large weui-ext-button--secondary logout-button"
      catchtap="handleLogout"
    >
      <view class="weui-ext-button__inner">退出登录</view>
    </button>
  </view>

  <mp-cells extClass="mine-menu-cells menu-card card-shadow">
    <mp-cell
      wx:for="{{menuList}}"
      wx:key="key"
      wx:for-index="index"
      extClass="mine-menu-cell {{index > 0 ? 'mine-menu-cell--with-divider' : ''}}"
      hasHeader="{{false}}"
      hasFooter="{{true}}"
      data-key="{{item.key}}"
      bind:tap="handleMenuTap"
    >
      <view>
        <view class="menu-title">{{item.title}}</view>
      </view>
      <mp-icon slot="footer" extClass="menu-arrow-icon" icon="arrow" type="outline" color="#b6bdc8" size="{{24}}" />
    </mp-cell>
  </mp-cells>

  <mp-dialog
    show="{{showServiceModal}}"
    title="联系客服"
    root-portal="{{true}}"
    extClass="service-dialog"
    buttons="{{serviceDialogButtons}}"
    bind:close="handleCloseService"
    bind:buttontap="handleServiceDialogTap"
  >
    <view class="service-modal-content">
      <image class="service-qrcode" src="{{serviceQrCode}}" mode="aspectFit"></image>
      <view class="service-tip">请使用微信扫码联系专属客服</view>
    </view>
  </mp-dialog>
</view>
