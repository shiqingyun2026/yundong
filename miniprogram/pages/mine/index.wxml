<view class="app-page mine-page">
  <app-feedback id="app-feedback" />
  <app-card extClass="profile-card card-shadow {{!userInfo ? 'profile-card-guest' : ''}}" bind:tap="handleProfileTap">
    <view class="profile-main">
      <view class="avatar-box {{!userInfo ? 'avatar-box-guest' : ''}}">
        <view class="avatar-placeholder">
          <app-icon className="avatar-placeholder-icon" name="avatar-user-inverse" />
        </view>
      </view>
      <view class="profile-info">
        <view class="profile-name {{!userInfo ? 'profile-name-guest' : ''}}">{{userInfo ? userInfo.nickName : '立即登录'}}</view>
      </view>
    </view>

    <app-button
      wx:if="{{userInfo}}"
      extClass="logout-button"
      variant="secondary"
      bind:tap="handleLogout"
    >
      退出登录
    </app-button>
  </app-card>

  <app-cells extClass="mine-menu-cells menu-card card-shadow">
    <app-cell
      wx:for="{{menuList}}"
      wx:key="key"
      wx:for-index="index"
      extClass="mine-menu-cell {{index > 0 ? 'mine-menu-cell--with-divider' : ''}}"
      hasHeader="{{false}}"
      hasFooter="{{true}}"
      data-key="{{item.key}}"
      bind:tap="handleMenuTap"
    >
      <view>
        <view class="menu-title">{{item.title}}</view>
      </view>
      <app-icon slot="footer" className="menu-arrow-icon" name="nav-forward-muted" />
    </app-cell>
  </app-cells>

  <base-modal
    visible="{{showServiceModal}}"
    title="联系客服"
    confirmText="我知道了"
    cancelText="关闭"
    bindclose="handleCloseService"
    bindcancel="handleCloseService"
    bindconfirm="handleConfirmService"
  >
    <view class="service-modal-content">
      <image class="service-qrcode" src="{{serviceQrCode}}" mode="aspectFit"></image>
      <view class="service-tip">请使用微信扫码联系专属客服</view>
    </view>
  </base-modal>

  <login-sheet
    visible="{{showLoginModal}}"
    loading="{{loginLoading}}"
    agreementChecked="{{loginAgreementChecked}}"
    bind:close="handleCloseLoginModal"
    bind:confirm="handleConfirmLogin"
    bind:toggleagreement="handleToggleLoginAgreement"
    bind:openagreement="handleOpenAgreement"
    bind:openprivacy="handleOpenPrivacy"
  />
</view>
