.mine-page {
  padding-bottom: 24rpx;
}

.profile-card,
.menu-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
}

.menu-card {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fbfcfe 100%);
}

.profile-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-card-guest {
  min-height: 156rpx;
}

.avatar-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-primary-light) 100%);
}

.avatar-box-guest {
  width: 134rpx;
  height: 134rpx;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.avatar-placeholder-icon {
  width: 44rpx;
  height: 44rpx;
}

.avatar-box-guest .avatar-placeholder-icon {
  width: 53rpx;
  height: 53rpx;
}

.avatar-placeholder {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
}

.profile-info {
  flex: 1;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
}

.profile-name-guest {
  font-size: 36rpx;
}

.logout-button {
  margin-top: 28rpx;
}

.menu-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1f2329;
}

.menu-arrow {
  color: #1f2329;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1;
  flex-shrink: 0;
}

.menu-arrow-icon {
  width: 24rpx;
  height: 24rpx;
}

.service-modal-content {
  padding-top: 8rpx;
  text-align: center;
}

.service-qrcode {
  width: 240rpx;
  height: 240rpx;
  margin: 0 auto;
  border-radius: 16rpx;
  background: #eef2f7;
}

.service-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #5f6b7a;
}
