.mine-page {
  padding-bottom: 24rpx;
}

.profile-card,
.menu-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
}

.menu-card {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fbfcfe 100%);
}

.profile-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-card-guest {
  min-height: 156rpx;
}

.avatar-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-primary-light) 100%);
}

.avatar-box-guest {
  width: 134rpx;
  height: 134rpx;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.avatar-placeholder-icon {
  width: 44rpx;
  height: 44rpx;
}

.avatar-box-guest .avatar-placeholder-icon {
  width: 53rpx;
  height: 53rpx;
}

.avatar-placeholder {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
}

.profile-info {
  flex: 1;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
}

.profile-name-guest {
  font-size: 36rpx;
}

.logout-button {
  margin-top: 28rpx;
}

.menu-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1f2329;
}

.menu-arrow {
  color: #1f2329;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1;
  flex-shrink: 0;
}

.menu-arrow-icon {
  width: 24rpx;
  height: 24rpx;
}

.service-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
  animation: service-mask-fade-in 0.3s ease;
}

.service-modal-card {
  width: 600rpx;
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.12);
  animation: service-card-slide-up 0.3s ease;
}

.service-modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #353535;
  line-height: 1.4;
  text-align: center;
}

.service-qrcode-wrap {
  width: 400rpx;
  height: 400rpx;
  margin: 32rpx auto 40rpx;
  padding: 8rpx;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.service-qrcode {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.service-close-button {
  width: 100% !important;
  height: 88rpx !important;
  border: none !important;
  border-radius: 16rpx !important;
  background: #1abcc5 !important;
  color: #ffffff !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
}

.service-close-button::after {
  border: none;
}

@keyframes service-mask-fade-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes service-card-slide-up {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}
