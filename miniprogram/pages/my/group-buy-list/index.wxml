<view class="page-shell my-group-list-page">
  <mp-toptips id="ui-toptips" root-portal="{{true}}" />
  <view class="group-tabs card-shadow">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="group-tab {{activeTab === item.key ? 'group-tab--active' : ''}}"
      data-key="{{item.key}}"
      bindtap="handleTabTap"
    >
      {{item.label}}
    </view>
  </view>

  <view wx:if="{{loading}}" class="page-loading">
    <mp-loading show="{{loading}}" type="dot-gray" />
    <text class="page-loading-text">拼团记录加载中...</text>
  </view>

  <view wx:if="{{!loading && groupList.length}}" class="group-list">
    <view
      class="weui-panel weui-ext-card group-card card-shadow"
      wx:for="{{groupList}}"
      wx:key="packageGroupId"
      data-group-id="{{item.packageGroupId}}"
      bind:tap="handleOpenDetail"
    >
      <view class="group-content">
        <view class="group-title-row">
          <view class="group-title">{{item.packageName}}</view>
          <view class="status-group">
            <mp-badge
              wx:if="{{item.status === 'active' && item.missingCount > 0}}"
              extClass="weui-ext-tag missing-tag"
              content="还缺{{item.missingCount}}人"
            />
            <mp-badge
              extClass="weui-ext-tag status-tag {{item.status === 'active' ? 'status-ongoing' : item.status === 'success' ? 'status-success' : 'status-failed'}}"
              content="{{item.status === 'active' ? '进行中' : item.status === 'success' ? '已成团' : '已失败'}}"
            />
          </view>
        </view>

        <view class="group-meta">{{item.displayTimeText}}</view>
        <view class="group-meta">{{item.locationText}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && !groupList.length}}" class="page-empty">
    <view class="page-empty-illustration"></view>
    <mp-msg extClass="page-empty-msg" title="暂无拼团记录" />
  </view>

  <view wx:if="{{groupList.length}}" class="list-footer">
    <block wx:if="{{loadingMore}}">
      <view class="footer-text">加载中...</view>
    </block>
    <block wx:elif="{{!hasMore}}">
      <view class="footer-text">没有更多拼团了</view>
    </block>
    <block wx:else>
      <view class="footer-text">上拉加载更多</view>
    </block>
  </view>
</view>
