<view class="page-shell my-group-list-page">
  <mp-toptips id="ui-toptips" />
  <view class="weui-navbar weui-ext-tabs tab-bar card-shadow">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="weui-navbar__item weui-ext-tabs__item tab-item {{activeTab === item.key ? 'weui-bar__item_on weui-ext-tabs__item--active tab-item-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="handleTabTap"
    >
      {{item.label}}
    </view>
  </view>

  <view wx:if="{{loading}}" class="page-loading">
    <mp-loading show="{{loading}}" type="dot-gray" />
    <text class="page-loading-text">拼团记录加载中...</text>
  </view>

  <view wx:if="{{!loading && groupList.length}}" class="group-list">
    <view
      class="weui-panel weui-ext-card group-card card-shadow"
      wx:for="{{groupList}}"
      wx:key="groupId"
      data-group-id="{{item.groupId}}"
      bind:tap="handleOpenDetail"
    >
      <image class="group-cover" src="{{item.cover}}" mode="aspectFill"></image>

      <view class="group-content">
        <view class="group-title-row">
          <view class="group-title">{{item.title}}</view>
          <view class="status-group">
            <mp-badge
              extClass="weui-ext-tag status-tag {{item.status === 'ongoing' ? 'status-ongoing' : item.status === 'success' ? 'status-success' : 'status-failed'}}"
              content="{{item.statusText}}"
            />
            <mp-badge wx:if="{{item.courseStatusText}}" extClass="weui-ext-tag status-tag status-stage" content="{{item.courseStatusText}}" />
          </view>
        </view>

        <view class="group-meta">{{item.timeText}}</view>
        <view class="group-meta">{{item.locationText}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && !groupList.length}}" class="page-empty">
    <view class="page-empty-illustration"></view>
    <mp-msg extClass="page-empty-msg" title="暂无拼团记录" />
  </view>

  <view wx:if="{{groupList.length}}" class="list-footer">
    <block wx:if="{{loadingMore}}">
      <view class="footer-text">加载中...</view>
    </block>
    <block wx:elif="{{!hasMore}}">
      <view class="footer-text">没有更多拼团了</view>
    </block>
    <block wx:else>
      <view class="footer-text">上拉加载更多</view>
    </block>
  </view>
</view>
