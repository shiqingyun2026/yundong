<view class="start-page">
  <mp-toptips id="ui-toptips" root-portal="{{true}}" />

  <view wx:if="{{loading}}" class="page-loading">
    <mp-loading show="{{loading}}" type="dot-gray" />
    <text class="page-loading-text">开团信息加载中...</text>
  </view>

  <view wx:if="{{!loading && packageDetail}}" class="start-scroll">
    <view class="page-shell">
      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">{{packageDetail.name}}</view>
      </view>

      <view wx:if="{{packageDetail.locations.length}}" class="weui-panel weui-ext-card page-section card-shadow location-select-card">
        <view class="section-title">选择上课地点</view>
        <view class="location-option-list">
          <view
            wx:for="{{packageDetail.locations}}"
            wx:key="id"
            class="location-option {{selectedLocationId === item.id ? 'location-option--active' : ''}}"
            data-location-id="{{item.id}}"
            bindtap="handleLocationSelect"
          >
            <view class="location-option-title">{{item.locationCommunity || item.locationText}}</view>
            <view class="location-option-desc">{{item.locationDetail || item.locationDistrict}}</view>
          </view>
        </view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">选择拼团人数</view>
        <view class="target-grid">
          <view
            wx:for="{{packageDetail.supportedGroupPriceList}}"
            wx:key="count"
            class="target-chip {{selectedTargetCount === item.count ? 'target-chip--active' : ''}}"
            data-value="{{item.count}}"
            bindtap="handleTargetSelect"
          >
            {{item.label || item.count + '人团'}}
          </view>
        </view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">{{classCount === 1 ? '选择上课日期与时间' : '上课时间（智能排课）'}}</view>

        <view wx:if="{{scheduleTypeOptions.length}}" class="schedule-type-section">
          <view class="schedule-type-grid">
            <view
              wx:for="{{scheduleTypeOptions}}"
              wx:key="value"
              class="schedule-type-chip {{selectedScheduleTypeValue === item.value ? 'schedule-type-chip--active' : ''}}"
              data-value="{{item.value}}"
              bindtap="handleScheduleTypeSelect"
            >
              {{item.label}}
            </view>
          </view>
        </view>

        <mp-cells extClass="start-form-cells start-schedule-cells">
          <mp-cell
            wx:if="{{classCount === 1 || selectedScheduleTypeValue === 'daily'}}"
            extClass="start-form-cell start-form-cell--picker start-schedule-cell"
            hasHeader="{{true}}"
            hasBody="{{true}}"
            hasFooter="{{false}}"
          >
            <view slot="title" class="start-form-label">上课日期</view>
            <picker
              class="start-form-picker"
              mode="date"
              start="{{minScheduleDate}}"
              value="{{selectedScheduleDate}}"
              bindchange="handleScheduleDateChange"
            >
              <view class="start-form-picker-content">
                <view class="start-form-value {{!selectedScheduleDate ? 'start-form-value--placeholder' : ''}}">
                  {{selectedScheduleDate || '请选择'}}
                </view>
                <view class="start-form-arrow {{!selectedScheduleDate ? 'start-form-arrow--placeholder' : ''}}">></view>
              </view>
            </picker>
          </mp-cell>

          <mp-cell
            wx:if="{{isWeeklySchedule}}"
            extClass="start-form-cell start-form-cell--picker start-schedule-cell"
            hasHeader="{{true}}"
            hasBody="{{true}}"
            hasFooter="{{false}}"
          >
            <view slot="title" class="start-form-label">上课日期</view>
            <view class="start-form-picker" bindtap="openScheduleDaysPopup">
              <view class="start-form-picker-content">
                <view class="start-form-value {{scheduleDaysDisplayText === '请选择' ? 'start-form-value--placeholder' : ''}}">
                  {{scheduleDaysDisplayText}}
                </view>
                <view class="start-form-arrow {{scheduleDaysDisplayText === '请选择' ? 'start-form-arrow--placeholder' : ''}}">></view>
              </view>
            </view>
          </mp-cell>

          <mp-cell
            extClass="start-form-cell start-form-cell--picker start-schedule-cell"
            hasHeader="{{true}}"
            hasBody="{{true}}"
            hasFooter="{{false}}"
          >
            <view slot="title" class="start-form-label">上课时间</view>
            <picker
              class="start-form-picker"
              mode="selector"
              range="{{timeOptions}}"
              range-key="label"
              value="{{selectedTimeIndex >= 0 ? selectedTimeIndex : 0}}"
              bindchange="handleTimeChange"
            >
              <view class="start-form-picker-content">
                <view class="start-form-value {{selectedScheduleTimeLabel === '请选择' ? 'start-form-value--placeholder' : ''}}">
                  {{selectedScheduleTimeLabel}}
                </view>
                <view class="start-form-arrow {{selectedScheduleTimeLabel === '请选择' ? 'start-form-arrow--placeholder' : ''}}">></view>
              </view>
            </picker>
          </mp-cell>
        </mp-cells>

        <view class="section-desc">
          {{classCount === 1 || selectedScheduleTypeValue === 'daily' ? '最早可选日期为开团后第 3 天。' : '系统会从开团后第 3 天起，按所选星期自动生成完整课表。'}}
        </view>
      </view>

      <view wx:if="{{classCount > 1}}" class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">课时预览</view>
        <view wx:if="{{schedulePreviewList.length}}" class="schedule-preview-list">
          <view
            wx:for="{{schedulePreviewList}}"
            wx:key="index"
            class="schedule-preview-item schedule-preview-item--editable"
            data-index="{{item.index}}"
            bindtap="openScheduleItemEditor"
          >
            <view class="schedule-preview-index">第{{item.index}}节</view>
            <view class="schedule-preview-text">{{item.displayText}}</view>
            <view class="schedule-preview-arrow">></view>
          </view>
        </view>
        <view wx:else class="section-desc">完成频率、日期/星期和时间选择后，将自动生成课时表。</view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">学生信息</view>
        <mp-cells extClass="start-form-cells child-form-cells">
          <mp-cell extClass="start-form-cell child-form-cell" hasHeader="{{true}}" hasBody="{{true}}" hasFooter="{{false}}">
            <view slot="title" class="start-form-label">学生昵称</view>
            <view class="start-form-input-wrapper">
              <input
                class="start-form-input"
                type="text"
                maxlength="20"
                placeholder=""
                cursor-spacing="24"
                confirm-type="done"
                value="{{childNickname}}"
                bindinput="handleChildNicknameInput"
                bindconfirm="handleStudentInputConfirm"
              />
              <view wx:if="{{!childNickname}}" class="start-form-input-placeholder">
                <view class="start-form-input-placeholder__text">请输入</view>
                <view class="start-form-arrow start-form-arrow--placeholder">></view>
              </view>
            </view>
          </mp-cell>
          <mp-cell extClass="start-form-cell child-form-cell" hasHeader="{{true}}" hasBody="{{true}}" hasFooter="{{false}}">
            <view slot="title" class="start-form-label">年龄</view>
            <view class="start-form-input-wrapper">
              <input
                class="start-form-input"
                type="text"
                inputmode="numeric"
                maxlength="2"
                placeholder=""
                cursor-spacing="24"
                confirm-type="done"
                value="{{childAge}}"
                bindinput="handleChildAgeInput"
                bindconfirm="handleStudentInputConfirm"
              />
              <view wx:if="{{!childAge}}" class="start-form-input-placeholder">
                <view class="start-form-input-placeholder__text">请输入</view>
                <view class="start-form-arrow start-form-arrow--placeholder">></view>
              </view>
            </view>
          </mp-cell>
          <mp-cell extClass="start-form-cell child-form-cell" hasHeader="{{true}}" hasBody="{{true}}" hasFooter="{{false}}">
            <view slot="title" class="start-form-label">家长手机号</view>
            <view class="start-form-input-wrapper">
              <input
                class="start-form-input"
                type="text"
                inputmode="numeric"
                maxlength="11"
                placeholder=""
                cursor-spacing="24"
                confirm-type="done"
                value="{{parentMobile}}"
                bindinput="handleParentMobileInput"
                bindconfirm="handleStudentInputConfirm"
              />
              <view wx:if="{{!parentMobile}}" class="start-form-input-placeholder">
                <view class="start-form-input-placeholder__text">请输入</view>
                <view class="start-form-arrow start-form-arrow--placeholder">></view>
              </view>
            </view>
          </mp-cell>
        </mp-cells>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">拼团说明</view>
        <view class="notice-list">
          <view class="notice-item"><view class="notice-dot"></view><view class="notice-text">满员或到截止时间达到最低成团人数都可成团</view></view>
          <view class="notice-item"><view class="notice-dot"></view><view class="notice-text">拼团截止时间：开团后48小时</view></view>
          <view class="notice-item"><view class="notice-dot"></view><view class="notice-text">未达到最低成团人数将自动原路退款</view></view>
        </view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow notice-card">
        <view class="section-title">上课注意事项</view>
        <view class="notice-list">
          <view class="notice-item"><view class="notice-dot"></view><view class="notice-text">开团后，按固定课时进行上课。</view></view>
          <view class="notice-item"><view class="notice-dot"></view><view class="notice-text">极端天气或请假人数过半，课程顺延至下周。</view></view>
          <view class="notice-item"><view class="notice-dot"></view><view class="notice-text">个人请假，不退费不补课。</view></view>
          <view class="notice-item"><view class="notice-dot"></view><view class="notice-text">上课期间，课程不得转让，不可更换学员。</view></view>
          <view class="notice-item"><view class="notice-dot"></view><view class="notice-text">饭后至少半个小时再运动，请家长提前做好安排。</view></view>
          <view class="notice-item"><view class="notice-dot"></view><view class="notice-text">上课前替换换好运动服和运动鞋，并准备好饮用水。</view></view>
          <view class="notice-item"><view class="notice-dot"></view><view class="notice-text">如学员有特殊情况，请提前告知。</view></view>
          <view class="notice-item"><view class="notice-dot"></view><view class="notice-text">每次上课，至少要求一个家长全程在场。</view></view>
        </view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow payment-agreement-card">
        <view class="payment-agreement-row" bindtap="handleAgreementToggle">
          <image
            class="payment-agreement-check-icon"
            src="{{agreementChecked ? '/assets/icons/check-one-primary.svg' : '/assets/icons/check-one-muted.svg'}}"
            mode="aspectFit"
          ></image>
          <view class="payment-agreement-inline">
            <text>我已阅读并同意</text>
            <text class="agreement-link" catchtap="handleOpenAgreement">《课程服务协议》</text>
          </view>
        </view>
      </view>

      <view class="bottom-placeholder"></view>
    </view>
  </view>

  <view wx:if="{{!loading && packageDetail}}" class="payment-bar">
    <button class="weui-btn weui-ext-button weui-ext-button--large weui-ext-button--primary payment-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="handleSubmit">
      <view class="weui-ext-button__inner">支付{{memberAmountDisplayText}}元并开团</view>
    </button>
  </view>

  <view wx:if="{{showScheduleDaysPopup}}" class="schedule-popup-mask" bindtap="closeScheduleDaysPopup"></view>
  <view wx:if="{{showScheduleDaysPopup}}" class="schedule-sheet">
    <view class="schedule-sheet__grabber"></view>
    <view class="schedule-sheet__header">
      <view class="schedule-sheet__title">选择上课日期</view>
      <view class="schedule-sheet__desc">需选择{{requiredScheduleDaysCount}}天</view>
    </view>
    <view class="weekday-chip-grid weekday-chip-grid--sheet">
      <view
        wx:for="{{weekdayOptions}}"
        wx:key="value"
        class="weekday-chip {{item.active ? 'weekday-chip--active' : ''}}"
        data-day="{{item.value}}"
        bindtap="handleScheduleDayToggle"
      >
        {{item.label}}
      </view>
    </view>
    <view class="schedule-sheet__actions">
      <button class="schedule-sheet__button schedule-sheet__button--ghost" bindtap="closeScheduleDaysPopup">取消</button>
      <button class="schedule-sheet__button schedule-sheet__button--primary" bindtap="confirmScheduleDaysPopup">确定</button>
    </view>
  </view>

  <view wx:if="{{showScheduleItemEditor}}" class="schedule-popup-mask" bindtap="closeScheduleItemEditor"></view>
  <view wx:if="{{showScheduleItemEditor}}" class="schedule-item-editor-sheet">
    <view class="schedule-item-editor-sheet__header">
      <view class="schedule-item-editor-sheet__title">选择上课时间</view>
      <view class="schedule-item-editor-sheet__close" bindtap="closeScheduleItemEditor">×</view>
    </view>

    <view class="schedule-item-editor-table">
      <view class="schedule-item-editor-table__head">
        <view class="schedule-item-editor-table__label">上课日期</view>
        <view class="schedule-item-editor-table__label">上课时间</view>
      </view>

      <view class="schedule-item-editor-table__body">
        <picker-view
          class="schedule-item-editor-picker-view"
          indicator-style="height: 112rpx;"
          value="{{[editingScheduleDateIndex, editingScheduleItemTimeIndex]}}"
          bindchange="handleScheduleItemPickerChange"
        >
          <picker-view-column class="schedule-item-editor-picker-column">
            <view
              wx:for="{{editingScheduleDateOptions}}"
              wx:key="value"
              class="schedule-item-editor-picker-item schedule-item-editor-picker-item--date"
            >
              {{item.label}}
            </view>
          </picker-view-column>
          <picker-view-column class="schedule-item-editor-picker-column">
            <view
              wx:for="{{timeOptions}}"
              wx:key="value"
              class="schedule-item-editor-picker-item schedule-item-editor-picker-item--center"
            >
              {{item.label}}
            </view>
          </picker-view-column>
        </picker-view>
      </view>
    </view>

    <view class="schedule-item-editor-sheet__actions">
      <button class="schedule-item-editor-sheet__button" bindtap="confirmScheduleItemEditor">确定</button>
    </view>
  </view>
</view>
