<view class="start-page">
  <mp-toptips id="ui-toptips" root-portal="{{true}}" />

  <view wx:if="{{loading}}" class="page-loading">
    <mp-loading show="{{loading}}" type="dot-gray" />
    <text class="page-loading-text">开团信息加载中...</text>
  </view>

  <view wx:if="{{!loading && packageDetail}}" class="start-scroll">
    <view class="page-shell">
      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">{{packageDetail.name}}</view>
        <view class="section-desc">{{packageDetail.locationDisplayText || packageDetail.locationText}}</view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">选择拼团人数</view>
        <view class="target-grid">
          <view
            wx:for="{{packageDetail.supportedPeople}}"
            wx:key="*this"
            class="target-chip {{selectedTargetCount === item ? 'target-chip--active' : ''}}"
            data-value="{{item}}"
            bindtap="handleTargetSelect"
          >
            {{item}} 人团
          </view>
        </view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">选择每周上课时间</view>
        <mp-cells extClass="start-form-cells start-schedule-cells">
          <mp-cell
            extClass="start-form-cell start-form-cell--picker start-schedule-cell"
            hasHeader="{{true}}"
            hasBody="{{true}}"
            hasFooter="{{false}}"
          >
            <view slot="title" class="start-form-label">星期</view>
            <picker
              class="start-form-picker"
              mode="selector"
              range="{{weekdayOptions}}"
              range-key="label"
              value="{{selectedWeekdayIndex}}"
              bindchange="handleWeekdayChange"
            >
              <view class="start-form-value">{{weekdayOptions[selectedWeekdayIndex].label}}</view>
            </picker>
          </mp-cell>
          <mp-cell
            extClass="start-form-cell start-form-cell--picker start-schedule-cell"
            hasHeader="{{true}}"
            hasBody="{{true}}"
            hasFooter="{{false}}"
          >
            <view slot="title" class="start-form-label">上课时间</view>
            <picker
              class="start-form-picker"
              mode="selector"
              range="{{hourOptions}}"
              range-key="label"
              value="{{selectedHourIndex}}"
              bindchange="handleHourChange"
            >
              <view class="start-form-value">{{hourOptions[selectedHourIndex].label}}</view>
            </picker>
          </mp-cell>
        </mp-cells>

        <view class="section-desc">系统会在成团后自动锁定首课日期，并连续生成 5 次课时。</view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">学生信息</view>
        <mp-cells extClass="start-form-cells child-form-cells">
          <mp-cell
            extClass="start-form-cell child-form-cell"
            hasHeader="{{true}}"
            hasBody="{{true}}"
            hasFooter="{{false}}"
          >
            <view slot="title" class="start-form-label">学生昵称</view>
            <input
              class="start-form-input"
              type="text"
              maxlength="20"
              placeholder="请输入学生昵称"
              cursor-spacing="24"
              confirm-type="done"
              value="{{childNickname}}"
              bindinput="handleChildNicknameInput"
              bindconfirm="handleStudentInputConfirm"
            />
          </mp-cell>
          <mp-cell
            extClass="start-form-cell child-form-cell"
            hasHeader="{{true}}"
            hasBody="{{true}}"
            hasFooter="{{false}}"
          >
            <view slot="title" class="start-form-label">年龄</view>
            <input
              class="start-form-input"
              type="text"
              inputmode="numeric"
              maxlength="2"
              placeholder="请输入年龄"
              cursor-spacing="24"
              confirm-type="done"
              value="{{childAge}}"
              bindinput="handleChildAgeInput"
              bindconfirm="handleStudentInputConfirm"
            />
          </mp-cell>
          <mp-cell
            extClass="start-form-cell child-form-cell"
            hasHeader="{{true}}"
            hasBody="{{true}}"
            hasFooter="{{false}}"
          >
            <view slot="title" class="start-form-label">家长手机号</view>
            <input
              class="start-form-input"
              type="text"
              inputmode="numeric"
              maxlength="11"
              placeholder="请输入家长手机号"
              cursor-spacing="24"
              confirm-type="done"
              value="{{parentMobile}}"
              bindinput="handleParentMobileInput"
              bindconfirm="handleStudentInputConfirm"
            />
          </mp-cell>
        </mp-cells>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">拼团说明</view>
        <view class="notice-list">
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">满员即成团</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">拼团截止时间：开团后48小时</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">未成团退款规则：48小时内未成团将自动原路退款</view>
          </view>
        </view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow notice-card">
        <view class="section-title">上课注意事项</view>
        <view class="notice-list">
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">开团后，按固定课时进行上课。</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">极端天气或请假人数过半，课程顺延至下周。</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">个人请假，不退费不补课。</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">上课期间，课程不得转让，不可更换学员。</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">饭后至少半个小时再运动，请家长提前做好安排。</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">上课前替换换好运动服和运动鞋，并准备好饮用水。</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">如学员有特殊情况，请提前告知。</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">每次上课，至少要求一个家长全程在场。</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">建议家长提前给孩子购买意外险。</view>
          </view>
        </view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow payment-agreement-card">
        <view class="payment-agreement-row">
          <mp-cells extClass="payment-agreement-cells">
            <mp-checkbox-group bind:change="handleAgreementChange">
              <mp-checkbox
                extClass="payment-agreement-item"
                value="agree"
                label=""
                checked="{{agreementChecked}}"
              />
            </mp-checkbox-group>
          </mp-cells>
          <view class="payment-agreement-inline">
            <text>我已阅读并同意</text>
            <text class="agreement-link" bindtap="handleOpenAgreement">《课程服务协议》</text>
          </view>
        </view>
      </view>

      <view class="bottom-placeholder"></view>
    </view>
  </view>

  <view wx:if="{{!loading && packageDetail}}" class="payment-bar">
    <button class="weui-btn weui-ext-button weui-ext-button--large weui-ext-button--primary payment-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="handleSubmit">
      <view class="weui-ext-button__inner">支付{{memberAmountDisplayText}}元并开团</view>
    </button>
  </view>
</view>
