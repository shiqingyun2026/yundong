.start-page {
  min-height: 100vh;
  background: #f7f8fa;
}

.start-scroll {
  min-height: 100vh;
}

.target-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.target-chip {
  min-width: 154rpx;
  padding: 18rpx 24rpx;
  border: 2rpx solid #e7ecf3;
  border-radius: 999rpx;
  color: #5f6b7a;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
}

.target-chip--active {
  border-color: var(--brand-primary);
  background: var(--brand-primary-soft);
  color: var(--brand-primary);
}

.picker-label {
  margin-top: 22rpx;
  font-size: 24rpx;
  color: #8f96a3;
}

.picker-label-second {
  margin-top: 24rpx;
}

.picker-value {
  margin-top: 10rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f7f8fa;
  color: #1f2329;
  font-size: 30rpx;
  font-weight: 600;
}

.form-input {
  margin-top: 10rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f7f8fa;
  color: #1f2329;
  font-size: 30rpx;
  font-weight: 500;
}

.payment-agreement-row {
  display: flex;
  align-items: center;
}

.payment-agreement-cells.weui-cells__group {
  margin-top: 0;
  flex: none;
}

.payment-agreement-cells .weui-cells {
  margin-top: 0;
  background: transparent;
}

.payment-agreement-cells .weui-cells::before,
.payment-agreement-cells .weui-cells::after {
  display: none;
}

.payment-agreement-item.weui-cell {
  padding: 0;
  background: transparent;
  min-height: auto;
}

.payment-agreement-item.weui-cell::before {
  display: none;
}

.payment-agreement-item .weui-check__label {
  display: none;
}

.payment-agreement-item .weui-cell__bd {
  display: none;
}

.payment-agreement-inline {
  flex: 1;
  padding-left: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #3c4655;
}

.agreement-link {
  color: var(--brand-primary);
}

.bottom-placeholder {
  height: 160rpx;
}

.payment-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 20rpx 0 calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 24rpx rgba(31, 35, 41, 0.06);
}

.payment-button {
  width: 100%;
  border-radius: 0;
}
