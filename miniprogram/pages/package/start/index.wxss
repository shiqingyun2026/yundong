.start-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f7f8fa;
}

.start-scroll {
  flex: 1;
  min-height: 100vh;
}

.start-page .page-section {
  padding: 28rpx 0;
}

.start-page .section-title,
.start-page .section-desc,
.start-page .target-grid {
  padding: 0 32rpx;
}

.start-page .section-desc {
  margin-top: 12rpx;
}

.start-page .section-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #111827;
}

.start-page .section-desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: #6b7280;
}

.start-page .notice-card {
  padding: 28rpx 0;
}

.start-page .notice-card .section-title {
  padding: 0 32rpx;
  text-align: left;
}

.start-page .notice-list {
  margin-top: 16rpx;
  padding: 0 32rpx;
}

.start-page .notice-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.start-page .notice-item + .notice-item {
  margin-top: 14rpx;
}

.start-page .notice-dot {
  width: 8rpx;
  height: 8rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: var(--brand-primary);
  flex-shrink: 0;
}

.start-page .notice-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6b7280;
}

.target-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.schedule-type-section {
  padding: 0 32rpx;
}

.schedule-type-grid,
.weekday-chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.schedule-type-grid {
  flex-wrap: nowrap;
  gap: 12rpx;
  overflow: hidden;
}

.schedule-type-chip,
.weekday-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 80rpx;
  padding: 0 18rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  background: #ffffff;
  color: #6b7280;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
}

.schedule-type-chip {
  flex: 1;
  white-space: nowrap;
}

.schedule-type-chip--active,
.weekday-chip--active {
  border-color: var(--brand-primary);
  background: var(--brand-primary-soft);
  color: var(--brand-primary);
  font-weight: 600;
}

.target-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc((100% - 36rpx) / 4);
  min-height: 80rpx;
  padding: 0 18rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  background: #ffffff;
  color: #6b7280;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
  box-sizing: border-box;
}

.target-chip--active {
  border-color: var(--brand-primary);
  background: var(--brand-primary-soft);
  color: var(--brand-primary);
  font-weight: 600;
}

.start-form-cells.weui-cells__group {
  margin-top: 16rpx;
}

.start-form-cells .weui-cells {
  margin-top: 0;
  border-top: 1px solid #f7f7f7;
  border-bottom: 1px solid #f7f7f7;
  background: #ffffff;
}

.start-form-cell.weui-cell {
  min-height: 88rpx;
  padding: 0 32rpx;
  align-items: center;
}

.start-form-cell--stack.weui-cell {
  align-items: flex-start;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

.start-form-cell.weui-cell::before {
  left: 32rpx;
  right: 32rpx;
  border-top: 1px solid #f7f7f7;
}

.start-form-cell .weui-cell__hd {
  width: 160rpx;
  padding: 0;
  flex-shrink: 0;
}

.start-form-cell .weui-cell__bd {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0;
  justify-content: flex-end;
}

.start-form-cell--stack .weui-cell__bd {
  display: block;
  min-height: 0;
}

.start-form-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.4;
}

.start-form-value {
  flex: 1;
  width: 100%;
  font-size: 28rpx;
  color: #111827;
  line-height: 1.4;
  text-align: right;
}

.start-form-input {
  width: 100%;
  height: 88rpx;
  font-size: 28rpx;
  color: #111827;
  line-height: 88rpx;
  text-align: right;
  position: relative;
  z-index: 1;
}

.start-form-value--placeholder,
.start-form-input-placeholder {
  color: #b2b2b2;
}

.start-form-input-wrapper {
  position: relative;
  width: 100%;
  min-height: 88rpx;
}

.start-form-input-placeholder {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 28rpx;
  line-height: 1.4;
  text-align: right;
  pointer-events: none;
}

.start-form-input-placeholder__text {
  line-height: 1.4;
}

.start-form-picker {
  flex: 1;
}

.start-form-picker-content {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 100%;
  min-height: 88rpx;
}

.start-form-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #111827;
  line-height: 1;
}

.start-form-arrow--placeholder {
  color: #b2b2b2;
}

.start-schedule-cells .weui-cells,
.child-form-cells .weui-cells {
  border-radius: 16rpx;
  overflow: hidden;
}

.start-schedule-cell.weui-cell {
  min-height: 88rpx;
  padding: 0 32rpx;
}

.start-schedule-cell .weui-cell__bd {
  justify-content: flex-end;
}

.child-form-cell.weui-cell {
  min-height: 88rpx;
  padding: 0 32rpx;
  background: #ffffff;
}

.payment-agreement-card {
  padding: 28rpx 0;
}

.payment-agreement-row {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  min-height: 52rpx;
}

.payment-agreement-check-icon {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

.payment-agreement-inline {
  flex: 1;
  padding-left: 0;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6b7280;
}

.agreement-link {
  color: var(--brand-primary);
}

.bottom-placeholder {
  height: 160rpx;
}

.schedule-preview-list {
  margin-top: 12rpx;
  padding: 0 32rpx;
}

.schedule-popup-mask {
  position: fixed;
  inset: 0;
  z-index: 29;
  background: rgba(17, 24, 39, 0.42);
}

.schedule-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -12rpx 48rpx rgba(15, 23, 42, 0.18);
  padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.schedule-sheet__grabber {
  width: 88rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: 999rpx;
  background: #d1d5db;
}

.schedule-sheet__header {
  margin-bottom: 24rpx;
}

.schedule-sheet__title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.4;
}

.schedule-sheet__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.weekday-chip-grid--sheet {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 0;
}

.weekday-chip-grid--sheet .weekday-chip {
  width: 100%;
  min-height: 84rpx;
  padding: 0;
}

.schedule-sheet__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.schedule-sheet__button {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  border: none;
  text-align: center;
}

.schedule-sheet__button::after {
  border: none;
}

.schedule-sheet__button--ghost {
  background: #f3f4f6;
  color: #6b7280;
}

.schedule-sheet__button--primary {
  background: var(--brand-primary);
  color: #ffffff;
}

.schedule-preview-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 88rpx;
  border-bottom: 1px solid #f3f4f6;
}

.schedule-preview-item--editable {
  cursor: pointer;
}

.schedule-preview-index {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #111827;
  font-weight: 600;
  line-height: 1.4;
}

.schedule-preview-text {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
  text-align: right;
  line-height: 1.4;
}

.schedule-preview-arrow {
  flex-shrink: 0;
  width: 20rpx;
  font-size: 28rpx;
  color: #111827;
  line-height: 1;
  text-align: right;
}

.schedule-item-editor-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 31;
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -12rpx 48rpx rgba(15, 23, 42, 0.18);
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.schedule-item-editor-sheet__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.schedule-item-editor-sheet__title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.4;
}

.schedule-item-editor-sheet__close {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 56rpx;
  color: #111827;
}

.schedule-item-editor-sheet__actions {
  margin-top: 32rpx;
}

.schedule-item-editor-table {
  margin-top: 28rpx;
}

.schedule-item-editor-table__head {
  display: flex;
  align-items: center;
  padding: 0 16rpx 12rpx;
}

.schedule-item-editor-table__label {
  flex: 1;
  font-size: 26rpx;
  color: #6b7280;
  font-weight: 500;
  text-align: center;
}

.schedule-item-editor-table__body {
  border-top: 1px solid #f3f4f6;
  border-bottom: 1px solid #f3f4f6;
}

.schedule-item-editor-picker-view {
  width: 100%;
  height: 336rpx;
}

.schedule-item-editor-picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 112rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  font-size: 32rpx;
  font-weight: 500;
  color: #111827;
  line-height: 112rpx;
  text-align: center;
}

.schedule-item-editor-picker-item--date {
  justify-content: center;
}

.schedule-item-editor-sheet__button {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: none;
  border-radius: 24rpx;
  background: #1abcc5;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
}

.schedule-item-editor-sheet__button::after {
  border: none;
}

.payment-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 20;
  padding: 20rpx 0 calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 24rpx rgba(31, 35, 41, 0.06);
}

.payment-button.weui-btn.weui-ext-button {
  width: calc(100% - 64rpx) !important;
  margin: 0 32rpx !important;
  height: 96rpx !important;
  padding: 0 !important;
  border-radius: 16rpx !important;
  background: var(--brand-primary) !important;
  color: #ffffff !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  box-shadow: 0 8rpx 24rpx var(--brand-primary-shadow-strong);
}

.payment-button.weui-btn.weui-ext-button::after {
  border: none;
  border-radius: 16rpx;
}
