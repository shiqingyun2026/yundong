<view class="payment-page">
  <mp-toptips id="ui-toptips" root-portal="{{true}}" />
  <view wx:if="{{loading}}" class="page-loading">
    <mp-loading show="{{loading}}" type="dot-gray" />
    <text class="page-loading-text">支付信息加载中...</text>
  </view>

  <scroll-view wx:if="{{!loading && packageDetail}}" class="payment-scroll" scroll-y>
    <view class="payment-content">
      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="order-title">{{packageDetail.name}}</view>
        <view class="order-item">
          <view class="order-label">上课地点</view>
          <view class="order-value">{{packageDetail.locationDisplayText || packageDetail.locationText}}</view>
        </view>
        <view wx:if="{{action === 'join' && packageGroupDetail && packageGroupDetail.scheduleDisplayText}}" class="order-item">
          <view class="order-label">上课时间</view>
          <view class="order-value">{{packageGroupDetail.scheduleDisplayText}}</view>
        </view>
        <view wx:if="{{action === 'join' && packageGroupDetail && packageGroupDetail.scheduleDisplayText}}" class="order-note">
          系统会在成团后自动锁定首课日期
        </view>
        <view class="order-item">
          <view class="order-label">上课人数</view>
          <view class="order-value">{{targetCount}} 人团</view>
        </view>
        <view class="order-item">
          <view class="order-label">学生昵称</view>
          <input
            class="order-input"
            type="text"
            maxlength="20"
            placeholder="请输入学生昵称"
            cursor-spacing="24"
            confirm-type="done"
            value="{{childNickname}}"
            bindinput="handleChildNicknameInput"
            bindconfirm="handleStudentInputConfirm"
          />
        </view>
        <view class="order-item">
          <view class="order-label">年龄</view>
          <input
            class="order-input"
            type="text"
            inputmode="numeric"
            maxlength="2"
            placeholder="请输入年龄"
            cursor-spacing="24"
            confirm-type="done"
            value="{{childAge}}"
            bindinput="handleChildAgeInput"
            bindconfirm="handleStudentInputConfirm"
          />
        </view>
        <view class="order-item">
          <view class="order-label">家长手机号</view>
          <input
            class="order-input"
            type="text"
            inputmode="numeric"
            maxlength="11"
            placeholder="请输入家长手机号"
            cursor-spacing="24"
            confirm-type="done"
            value="{{parentMobile}}"
            bindinput="handleParentMobileInput"
            bindconfirm="handleStudentInputConfirm"
          />
        </view>
      </view>

      <view wx:if="{{packageGroupDetail}}" class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">当前进度</view>
        <view class="progress-header">
          <view class="progress-text">{{packageGroupDetail.currentCount}} / {{packageGroupDetail.targetCount}}</view>
          <view class="remaining-text">{{packageGroupDetail.remainingText}}</view>
        </view>
        <view class="progress-track">
          <view class="progress-bar" style="width: {{packageGroupDetail.progressPercent}};"></view>
        </view>
      </view>

      <view wx:if="{{packageGroupDetail}}" class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">成员列表</view>
        <view wx:if="{{packageGroupDetail.members.length}}" class="member-list-block">
          <view wx:for="{{packageGroupDetail.members}}" wx:key="user_id" class="member-item">
            <image class="member-avatar" src="{{item.avatar_url}}" mode="aspectFill"></image>
            <view class="member-name">{{item.displayText || item.displayName || item.nickname}}</view>
          </view>
        </view>
        <view wx:else class="section-desc">暂未获取到成员信息</view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">拼团说明</view>
        <view class="notice-list">
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">满员即成团</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">拼团截止时间：开团后48小时</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">未成团退款规则：48小时内未成团将自动原路退款</view>
          </view>
        </view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow notice-card">
        <view class="section-title">上课注意事项</view>
        <view class="notice-list">
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">开团后，按固定课时进行上课。</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">极端天气或请假人数过半，课程顺延至下周。</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">个人请假，不退费不补课。</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">上课期间，课程不得转让，不可更换学员。</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">饭后至少半个小时再运动，请家长提前做好安排。</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">上课前替换换好运动服和运动鞋，并准备好饮用水。</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">如学员有特殊情况，请提前告知。</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">每次上课，至少要求一个家长全程在场。</view>
          </view>
          <view class="notice-item">
            <view class="notice-dot"></view>
            <view class="notice-text">建议家长提前给孩子购买意外险。</view>
          </view>
        </view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="payment-agreement-row">
          <mp-cells extClass="payment-agreement-cells">
            <mp-checkbox-group bind:change="handleAgreementChange">
              <mp-checkbox
                extClass="payment-agreement-item"
                value="agree"
                label=""
                checked="{{agreementChecked}}"
              />
            </mp-checkbox-group>
          </mp-cells>
          <view class="payment-agreement-inline">
            <text>我已阅读并同意</text>
            <text class="agreement-link" bindtap="handleOpenAgreement">《课程服务协议》</text>
          </view>
        </view>
      </view>

      <view class="bottom-placeholder"></view>
    </view>
  </scroll-view>

  <view wx:if="{{!loading && packageDetail}}" class="payment-bar">
    <button class="weui-btn weui-ext-button weui-ext-button--large weui-ext-button--primary payment-button" loading="{{paying}}" disabled="{{paying}}" bindtap="handleConfirmPay">
      <view class="weui-ext-button__inner">确认支付{{paymentAmountButtonText}}</view>
    </button>
    <button class="weui-btn weui-ext-button weui-ext-button--medium weui-ext-button--text mock-fail-button" bindtap="handleMockFail">
      <view class="weui-ext-button__inner">模拟支付失败</view>
    </button>
  </view>
</view>
