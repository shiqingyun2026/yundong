<view class="payment-page">
  <mp-toptips id="ui-toptips" root-portal="{{true}}" />
  <view wx:if="{{loading}}" class="page-loading">
    <mp-loading show="{{loading}}" type="dot-gray" />
    <text class="page-loading-text">支付信息加载中...</text>
  </view>

  <scroll-view wx:if="{{!loading && packageDetail}}" class="payment-scroll" scroll-y>
    <view class="payment-content">
      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">订单信息</view>
        <view class="order-title">{{packageDetail.name}}</view>
        <view class="order-item">
          <view class="order-label">上课地点</view>
          <view class="order-value">{{packageDetail.locationDisplayText || packageDetail.locationText}}</view>
        </view>
        <view class="order-item">
          <view class="order-label">开团方式</view>
          <view class="order-value">{{action === 'start' ? '发起开团' : '参与现有拼团'}}</view>
        </view>
        <view class="order-item">
          <view class="order-label">目标人数</view>
          <view class="order-value">{{targetCount}} 人团</view>
        </view>
        <view class="order-item">
          <view class="order-label">孩子昵称</view>
          <view wx:if="{{action === 'start'}}" class="order-value">{{childNickname}}</view>
          <input
            wx:else
            class="order-input"
            type="text"
            maxlength="20"
            placeholder="请输入孩子昵称"
            cursor-spacing="24"
            value="{{childNickname}}"
            bindinput="handleChildNicknameInput"
          />
        </view>
        <view class="order-item">
          <view class="order-label">年龄</view>
          <view wx:if="{{action === 'start'}}" class="order-value">{{childAge}} 岁</view>
          <input
            wx:else
            class="order-input"
            type="number"
            maxlength="2"
            placeholder="请输入年龄"
            cursor-spacing="24"
            value="{{childAge}}"
            bindinput="handleChildAgeInput"
          />
        </view>
        <view class="order-item price-item">
          <view class="order-label">支付金额</view>
          <view class="payment-price">¥{{paymentAmountText}}</view>
        </view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <view class="section-title">拼团说明</view>
        <view class="section-desc">满 {{targetCount}} 人成团</view>
        <view class="section-desc">
          拼团截止时间：{{packageGroupDetail ? packageGroupDetail.remainingText : '开团成功后 48 小时'}}
        </view>
        <view class="section-desc">
          未成团退款规则：48 小时内未成团将自动原路退款
        </view>
        <view class="section-desc">
          {{action === 'start' ? '支付成功后才会真正创建拼团，系统会在成团后锁定首课日期。' : '支付成功后即加入该团，达到目标人数后自动成团。'}}
        </view>
      </view>

      <view class="weui-panel weui-ext-card page-section card-shadow">
        <mp-cells extClass="payment-agreement-cells">
          <mp-checkbox-group bind:change="handleAgreementChange">
            <mp-checkbox
              extClass="payment-agreement-item"
              value="agree"
              checked="{{agreementChecked}}"
            />
          </mp-checkbox-group>
        </mp-cells>
        <view class="payment-agreement-inline">
          <text>我已阅读并同意</text>
          <text class="agreement-link" bindtap="handleOpenAgreement">《课程服务协议》</text>
        </view>
      </view>

      <view class="bottom-placeholder"></view>
    </view>
  </scroll-view>

  <view wx:if="{{!loading && packageDetail}}" class="payment-bar">
    <button class="weui-btn weui-ext-button weui-ext-button--large weui-ext-button--primary payment-button" loading="{{paying}}" disabled="{{paying}}" bindtap="handleConfirmPay">
      <view class="weui-ext-button__inner">确认支付</view>
    </button>
    <button class="weui-btn weui-ext-button weui-ext-button--medium weui-ext-button--text mock-fail-button" bindtap="handleMockFail">
      <view class="weui-ext-button__inner">模拟支付失败</view>
    </button>
  </view>
</view>
