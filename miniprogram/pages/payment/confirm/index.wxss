.payment-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f7f8fa;
}

.payment-scroll {
  flex: 1;
  height: 100vh;
}

.payment-content {
  padding: 24rpx;
}

.order-title {
  padding: 0 32rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
  color: #1f2329;
}

.order-item {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 0 32rpx;
  border-top: 1px solid #f7f7f7;
}

.order-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 500;
  color: #353535;
  line-height: 1.4;
}

.order-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.4;
  color: #353535;
  text-align: right;
}

.order-note {
  margin: -2rpx 32rpx 0 192rpx;
  color: #8f96a3;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: right;
}

.order-input {
  flex: 1;
  height: 88rpx;
  padding: 0;
  background: transparent;
  font-size: 28rpx;
  color: #353535;
  text-align: right;
}

.rich-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #3c4655;
  line-height: 1.8;
}

.progress-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.progress-text,
.remaining-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
}

.remaining-text {
  color: #5f6b7a;
}

.progress-track {
  width: 100%;
  height: 18rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #eef2f7;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--brand-primary) 0%, var(--brand-primary-light) 100%);
}

.member-list-block {
  margin-top: 20rpx;
}

.member-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.member-item + .member-item {
  margin-top: 16rpx;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 2rpx solid #e5f5f6;
  background: #ffffff;
}

.member-name {
  font-size: 28rpx;
  color: #1f2329;
}

.notice-card {
  padding: 28rpx 0;
}

.notice-card .section-title {
  padding: 0 32rpx;
  text-align: left;
}

.notice-list {
  margin-top: 16rpx;
  padding: 0 32rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.notice-item + .notice-item {
  margin-top: 14rpx;
}

.notice-dot {
  width: 8rpx;
  height: 8rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: var(--brand-primary);
  flex-shrink: 0;
}

.notice-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.7;
  color: #5f6b7a;
}

.payment-agreement-card {
  padding: 28rpx 0;
}

.payment-agreement-row {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  min-height: 52rpx;
}

.payment-agreement-check-icon {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

.agreement-link {
  color: var(--brand-primary);
}

.payment-agreement-inline {
  flex: 1;
  padding-left: 0;
  font-size: 26rpx;
  line-height: 1.7;
  color: #3c4655;
}

.bottom-placeholder {
  height: 260rpx;
}

.payment-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 24rpx rgba(31, 35, 41, 0.06);
}

.service-entry {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.service-share-button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: normal;
}

.service-share-button::after {
  border: 0;
}

.service-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: var(--brand-primary-soft);
}

.service-icon-image {
  width: 28rpx;
  height: 28rpx;
}

.service-icon-image--share {
  width: 48rpx;
  height: 48rpx;
}

.service-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #5f6b7a;
}

.payment-button {
  height: 96rpx !important;
  padding: 0 !important;
  border-radius: 16rpx !important;
  box-shadow: 0 8rpx 24rpx var(--brand-primary-shadow-strong);
}

.payment-button--full {
  width: 100% !important;
  margin: 0 !important;
}

.payment-action {
  flex: 3.7;
  min-width: 0;
  margin: 0 !important;
}
