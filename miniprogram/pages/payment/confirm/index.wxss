.payment-page {
  min-height: 100vh;
  background: #f7f8fa;
}

.payment-scroll {
  height: 100vh;
}

.payment-content {
  padding: 24rpx;
}

.order-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.5;
  color: #1f2329;
}

.order-item {
  margin-top: 20rpx;
}

.order-label {
  font-size: 24rpx;
  color: #8f96a3;
}

.order-value {
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #1f2329;
}

.order-input {
  margin-top: 8rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #f7f8fa;
  font-size: 28rpx;
  color: #1f2329;
}

.rich-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #3c4655;
  line-height: 1.8;
}

.progress-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.progress-text,
.remaining-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
}

.remaining-text {
  color: #5f6b7a;
}

.progress-track {
  width: 100%;
  height: 18rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #eef2f7;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--brand-primary) 0%, var(--brand-primary-light) 100%);
}

.member-list-block {
  margin-top: 20rpx;
}

.member-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.member-item + .member-item {
  margin-top: 16rpx;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eef2f7;
}

.member-name {
  font-size: 28rpx;
  color: #1f2329;
}

.payment-agreement-row {
  display: flex;
  align-items: flex-start;
}

.payment-agreement-cells.weui-cells__group {
  margin-top: 0;
  flex: none;
}

.payment-agreement-cells .weui-cells {
  margin-top: 0;
  background: transparent;
}

.payment-agreement-cells .weui-cells::before,
.payment-agreement-cells .weui-cells::after {
  display: none;
}

.payment-agreement-item.weui-cell {
  padding: 0;
  background: transparent;
}

.payment-agreement-item.weui-cell::before {
  display: none;
}

.payment-agreement-item .weui-cell__bd {
  font-size: 26rpx;
  line-height: 1.7;
  color: #3c4655;
}

.agreement-link {
  color: var(--brand-primary);
}

.payment-agreement-inline {
  flex: 1;
  padding-left: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #3c4655;
}

.bottom-placeholder {
  height: 160rpx;
}

.payment-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 24rpx rgba(31, 35, 41, 0.06);
}

.payment-button {
  width: 100%;
}

.mock-fail-button {
  height: 72rpx;
  margin-top: 12rpx;
  border: none;
  background: transparent;
  color: #8f96a3;
  font-size: 24rpx;
  line-height: 72rpx;
}

.mock-fail-button::after {
  border: none;
}
