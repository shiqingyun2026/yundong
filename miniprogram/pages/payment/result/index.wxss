.result-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f7f8fa;
}

.result-card {
  margin-top: 120rpx;
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  text-align: center;
}

.result-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto;
  border-radius: 50%;
}

.result-icon-image {
  width: 56rpx;
  height: 56rpx;
}

.icon-success {
  background: var(--brand-primary-soft);
  color: var(--brand-primary);
}

.icon-fail {
  background: #fff1f0;
  color: #ff4d4f;
}

.result-button {
  width: 100%;
  margin-top: 32rpx;
}

.subscribe-card {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #ffffff 0%, var(--brand-primary-soft) 100%);
  text-align: left;
}

.subscribe-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
}

.subscribe-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5f6b7a;
}

.subscribe-button {
  width: 100%;
  margin-top: 20rpx;
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-primary-strong) 100%);
  color: #ffffff;
}

.subscribe-status {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
}

.subscribe-status-success {
  color: var(--brand-primary);
}

.subscribe-status-muted {
  color: #86909c;
}

.secondary-text-button {
  width: 100%;
  height: 72rpx;
  margin-top: 20rpx;
  padding: 0;
  border: none;
  background: transparent;
  color: #5f6b7a;
  font-size: 26rpx;
  line-height: 72rpx;
}

.result-button::after,
.subscribe-button::after {
  border: none;
}

.secondary-text-button::after {
  border: none;
}
