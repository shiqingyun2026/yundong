.result-page {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  min-height: 100vh;
  padding: 24rpx;
  background: #f7f8fa;
}

.result-card {
  width: 100%;
  margin-top: 112rpx;
  padding: 56rpx 40rpx 48rpx;
  border-radius: 24rpx;
  background: #ffffff;
  text-align: center;
}

.result-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto;
  border-radius: 50%;
}

.result-icon-image {
  width: 56rpx;
  height: 56rpx;
}

.icon-success {
  background: var(--brand-primary-soft);
  color: var(--brand-primary);
}

.icon-fail {
  background: #fff3f2;
  color: #ff6b6b;
}

.result-title {
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.35;
}

.result-desc {
  margin: 18rpx auto 0;
  max-width: 560rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #5f6b7a;
}

.subscribe-card {
  margin-top: 36rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #ffffff 0%, var(--brand-primary-soft) 100%);
  text-align: left;
}

.subscribe-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
}

.subscribe-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5f6b7a;
}

.subscribe-button {
  width: 100%;
  margin-top: 20rpx;
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-primary-strong) 100%);
  color: #ffffff;
}

.subscribe-status {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
}

.subscribe-status-success {
  color: var(--brand-primary);
}

.subscribe-status-muted {
  color: #86909c;
}

.result-action-group {
  width: calc(100% + 48rpx);
  margin-top: 40rpx;
  margin-left: -24rpx;
  margin-right: -24rpx;
}

.result-button.weui-btn.weui-ext-button,
.secondary-button-outline.weui-btn.weui-ext-button {
  width: calc(100% - 64rpx) !important;
  margin-left: auto !important;
  margin-right: auto !important;
}

.secondary-button-outline.weui-btn.weui-ext-button {
  height: 88rpx;
  margin-top: 20rpx !important;
  border: 2rpx solid var(--brand-primary-border) !important;
  border-radius: 16rpx !important;
  background: #ffffff !important;
  color: var(--brand-primary) !important;
}

.result-button::after,
.subscribe-button::after,
.secondary-button-outline::after {
  border: none;
}
